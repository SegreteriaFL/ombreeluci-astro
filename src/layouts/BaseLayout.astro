---
/**
 * BaseLayout.astro
 *
 * Layout base condiviso da tutte le pagine del sito.
 * Fornisce: html+head (via BaseHead) + Header + Footer + slot contenuto.
 *
 * Slot disponibili:
 *   <slot />           — contenuto principale (obbligatorio)
 *   <slot name="head"> — tag extra nel <head> (JSON-LD, meta pagina specifica)
 *
 * Uso standard:
 *   <BaseLayout title="Titolo" description="...">
 *     <main>...</main>
 *   </BaseLayout>
 *
 * Uso con head extra (es. JSON-LD):
 *   <BaseLayout title="Articolo" ogType="article">
 *     <script slot="head" type="application/ld+json">{JSON.stringify(schema)}</script>
 *     <main>...</main>
 *   </BaseLayout>
 *
 * Pagine custom verticali (serie, dossier):
 *   Usano lo slot default per iniettare hero full-width, sezioni custom, ecc.
 *   Non esiste una struttura forzata dopo Header e prima di Footer.
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  lang?: 'it' | 'en';
  alternates?: { lang: string; url: string }[];
  /** Classe aggiuntiva per il tag <body> */
  bodyClass?: string;
  /** URL alternativo dell'articolo nell'altra lingua (per LanguageSelector) */
  alternateArticleUrl?: string | null;
  /** Path corrente (nav attiva, language selector); default: URL della richiesta */
  pathname?: string;
  /** Header trasparente sopra hero slider (solo homepage) */
  heroHeader?: boolean;
  /** URL immagine LCP da preloadare */
  lcpImage?: string;
}

const { bodyClass, alternateArticleUrl = null, pathname: pathnameProp, heroHeader, ...headProps } = Astro.props;
const pathname = pathnameProp ?? Astro.url.pathname;
const lang = headProps.lang ?? 'it';
---

<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        var inIframe = (function () { try { return window.self !== window.top; } catch (e) { return true; } })();
        if (!inIframe) document.documentElement.classList.add('page-loading');

        var safetyTimer = null;

        function ready() {
          if (safetyTimer) { clearTimeout(safetyTimer); safetyTimer = null; }
          document.documentElement.classList.remove('page-loading');
          var loader = document.getElementById('page-loader');
          if (document.body) document.body.classList.add('ready');
          if (loader) {
            loader.classList.add('hidden');
            setTimeout(function () {
              if (loader.parentNode) loader.parentNode.removeChild(loader);
            }, 300);
          }
        }

        // Safety: forza ready() dopo 8s se nessun evento l'ha già chiamata
        function armSafety() {
          if (safetyTimer) clearTimeout(safetyTimer);
          safetyTimer = setTimeout(ready, 8000);
        }
        armSafety();

        // DOMContentLoaded: caricamento iniziale
        // Nota: i module script in <head> sono deferred — DOMContentLoaded li aspetta.
        // Il readyState check gestisce il caso raro in cui DCL sia già scattato.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', ready);
        } else {
          ready();
        }

        document.addEventListener('astro:before-preparation', function () {
          if (!inIframe) document.documentElement.classList.add('page-loading');
          if (document.body) document.body.classList.remove('ready');
          if (!document.getElementById('page-loader')) {
            var newLoader = document.createElement('div');
            newLoader.id = 'page-loader';
            newLoader.setAttribute('aria-hidden', 'true');
            newLoader.innerHTML = '<div class="page-loader-spinner"></div>';
            if (document.body) document.body.insertBefore(newLoader, document.body.firstChild);
          }
          armSafety();
        });

        document.addEventListener('astro:page-load', ready);
      })();
    </script>
    <BaseHead {...headProps}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body class:list={[bodyClass]}>
    <div id="page-loader" aria-hidden="true">
      <div class="page-loader-spinner"></div>
    </div>
    <Header lang={lang} pathname={pathname} alternateArticleUrl={alternateArticleUrl} heroHeader={heroHeader} />
    <slot />
    <Footer lang={lang} pathname={pathname} />
  </body>
</html>
