---
// ArticleCard.astro – struttura: contenitore, link (solo immagine+badge+titolo), riga autore fuori dal link
import { COPERTINA_IMG_ONERROR } from '../lib/directus';
import { getPlaceholder } from '../utils/placeholder';
import { t, localizeFormalType, localizeCategory, getAuthorBasePath, type Locale } from '../utils/i18n';

const {
  title,
  author,
  date,
  issue,
  slug,
  image,
  categoriaMenu,
  forma,
  ruoloEditoriale,
  lang = 'it',
  horizontal = false,
  sottotitolo = null,
  authorImage = null,
  hideImage = false,
  basePath = '/it',
} = Astro.props as {
  title: string;
  author: string;
  date: Date | string;
  issue?: string | null;
  slug: string;
  image?: string | null;
  categoriaMenu?: string | null;
  forma?: string | null;
  ruoloEditoriale?: string | null;
  lang?: Locale;
  horizontal?: boolean;
  sottotitolo?: string | null;
  authorImage?: string | null;
  hideImage?: boolean;
  /** Base path per il link articolo. Default: '/blog'. Usare '/en' per la sezione EN. */
  basePath?: string;
};
const hasIssue = issue != null && String(issue).trim() !== '';
const imageSrc = (!hideImage && image) ? image : (!hideImage ? getPlaceholder(slug ?? title ?? '').src : null);
// Badge: mostra solo categoria (+ forma se != Articolo). Label forma da i18n (allineato a taxonomy).
const localizedForma = forma ? localizeFormalType(forma, lang) : null;
const genericFormalLabel = t(lang, 'formal_articolo');
const localizedCategoriaMenu = localizeCategory(categoriaMenu ?? null, lang) ?? categoriaMenu;
const formaPrefix =
  localizedForma && localizedForma !== genericFormalLabel ? `${localizedForma} · ` : '';
const badgeText = categoriaMenu
  ? `${formaPrefix}${localizedCategoriaMenu}`
  : (hasIssue ? '' : t(lang, 'badge_online'));

function authorSlug(name: string): string {
  return String(name)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const dateLocale = lang === 'en' ? 'en-US' : 'it-IT';
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date instanceof Date ? date : new Date(date));

const authorLinkSlug = authorSlug(author);
const authorBasePath = getAuthorBasePath(lang);
---

<div class={`article-card${horizontal ? ' article-card--horizontal' : ''}`}>
  <a href={`${basePath}/${slug}`} class="article-link">
    {imageSrc && (
      <div class="article-image-wrap">
        <img
          src={imageSrc}
          alt={title}
          loading="lazy"
          data-copertina-fallback
          onerror={COPERTINA_IMG_ONERROR}
        />
      </div>
    )}
    <div class="article-meta">
      {badgeText && (
        <p class="article-badge">
          <span class="article-badge-text">{badgeText}</span>
        </p>
      )}
      <h3 class="article-title">{title}</h3>
      {horizontal && sottotitolo && <p class="article-sottotitolo">{sottotitolo}</p>}
    </div>
  </a>
  <p class="author-row">
    {horizontal && authorImage && (
      <img src={authorImage} alt={author} class="author-avatar" loading="lazy" />
    )}
    {t(lang, 'author_by')} <a href={`${authorBasePath}/${authorLinkSlug}`} class="author-link">{author}</a> • {formattedDate}
  </p>
</div>
