---
// ArticleCard.astro – struttura: contenitore, link (solo immagine+badge+titolo), riga autore fuori dal link
import { COPERTINA_IMG_ONERROR } from '../lib/directus';
import { getPlaceholder } from '../utils/placeholder';
import { t, type Locale } from '../utils/i18n';

const {
  title,
  author,
  date,
  issue,
  slug,
  image,
  categoriaMenu,
  forma,
  ruoloEditoriale,
  lang = 'it',
  horizontal = false,
  sottotitolo = null,
  authorImage = null,
  hideImage = false
} = Astro.props as {
  title: string;
  author: string;
  date: Date | string;
  issue?: string | null;
  slug: string;
  image?: string | null;
  categoriaMenu?: string | null;
  forma?: string | null;
  ruoloEditoriale?: string | null;
  lang?: Locale;
  horizontal?: boolean;
  sottotitolo?: string | null;
  authorImage?: string | null;
  hideImage?: boolean;
};
const hasIssue = issue != null && String(issue).trim() !== '';
const imageSrc = (!hideImage && image) ? image : (!hideImage ? getPlaceholder(slug ?? title ?? '').src : null);
// Badge: mostra solo categoria (+ forma se != Articolo). Pulito, senza jargon interno.
const FORMAL_LABELS_EN: Record<string, string> = {
  Articolo: 'Article',
  Intervista: 'Interview',
  Recensione: 'Review',
  Testimonianza: 'Testimonial',
  Editoriale: 'Editorial',
};
const localizedForma = (() => {
  if (!forma) return null;
  if (lang !== 'en') return forma;
  return FORMAL_LABELS_EN[forma] ?? forma;
})();
const formaPrefix = localizedForma && localizedForma !== (lang === 'en' ? 'Article' : 'Articolo') ? `${localizedForma} · ` : '';
const badgeText = categoriaMenu
  ? `${formaPrefix}${categoriaMenu}`
  : (hasIssue ? '' : t(lang, 'badge_online'));

function authorSlug(name: string): string {
  return String(name)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const dateLocale = lang === 'en' ? 'en-GB' : 'it-IT';
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date instanceof Date ? date : new Date(date));

const authorLinkSlug = authorSlug(author);
---

<div class={`article-card${horizontal ? ' article-card--horizontal' : ''}`}>
  <a href={`/blog/${slug}`} class="article-link">
    {imageSrc && (
      <div class="article-image-wrap">
        <img
          src={imageSrc}
          alt={title}
          loading="lazy"
          data-copertina-fallback
          onerror={COPERTINA_IMG_ONERROR}
        />
      </div>
    )}
    <div class="article-meta">
      {badgeText && (
        <p class="article-badge">
          <span class="article-badge-text">{badgeText}</span>
        </p>
      )}
      <h3 class="article-title">{title}</h3>
      {horizontal && sottotitolo && <p class="article-sottotitolo">{sottotitolo}</p>}
    </div>
  </a>
  <p class="author-row">
    {horizontal && authorImage && (
      <img src={authorImage} alt={author} class="author-avatar" loading="lazy" />
    )}
    {t(lang, 'author_by')} <a href={`/autori/${authorLinkSlug}`} class="author-link">{author}</a> • {formattedDate}
  </p>
</div>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 4px;
  }

  /* Variante orizzontale: immagine sx, testo dx */
  .article-card--horizontal {
    flex-direction: row;
    gap: 1rem;
    align-items: flex-start;
  }
  .article-card--horizontal .article-link {
    flex-direction: row;
    gap: 1rem;
    align-items: flex-start;
  }
  .article-card--horizontal .article-image-wrap {
    width: 140px;
    min-width: 140px;
    aspect-ratio: 4/3;
    margin-bottom: 0;
  }
  .article-card--horizontal .article-title {
    font-size: 1rem;
    -webkit-line-clamp: 3;
  }
  .article-card--horizontal .author-row {
    font-size: 0.8125rem;
    white-space: normal;
    flex-wrap: wrap;
  }
  @media (max-width: 480px) {
    .article-card--horizontal .article-image-wrap {
      width: 100px;
      min-width: 100px;
    }
  }

  .article-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
    align-items: flex-start;
  }

  .article-image-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .article-image-wrap img {
    width: 100%;
    height: auto;
    min-height: 120px;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .article-link:hover .article-image-wrap img {
    transform: scale(1.03);
  }
  @media (max-width: 480px) {
    .author-row { white-space: normal; flex-wrap: wrap; }
  }

  .article-meta {
    width: 100%;
    margin: 0;
  }

  .article-badge {
    margin: 0 0 4px 0;
    color: var(--accent-color);
    font-family: 'Raleway', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .article-badge-muted {
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.05);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    width: fit-content;
    text-transform: none;
  }

  .article-badge-text {
    display: inline;
  }


  .article-title {
    margin: 4px 0;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--text-color);
    font-size: 1.25rem;
    transition: color 0.2s ease;
  }

  .article-link:hover .article-title {
    color: var(--accent-color);
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .author-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    display: inline;
  }

  .article-sottotitolo {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 4px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .author-row--inline {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    white-space: normal;
    flex-wrap: wrap;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>
