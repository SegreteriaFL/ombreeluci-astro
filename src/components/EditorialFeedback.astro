---
interface Props {
  wpId?: number | string | null;
  title: string;
  currentRole?: string | null;
  url: string;
}

const { wpId, title, currentRole, url } = Astro.props;

// Visibile solo se URL contiene ?redazione=1 (verificato lato client)
---

<aside class="editorial-feedback" aria-label="Box revisione editoriale" id="editorial-feedback-box" hidden>
    <div class="editorial-feedback-header">
      <span class="editorial-feedback-title">BOX REVISIONE EDITORIALE</span>
    </div>
    <form
      id="editorial-feedback-form"
      class="editorial-feedback-form"
      method="post"
    >
      <div class="editorial-feedback-row">
        <label for="proposed_role" class="editorial-feedback-label">
          Ruolo proposto
        </label>
        <select
          id="proposed_role"
          name="proposed_role"
          class="editorial-feedback-select"
        >
          <option value="">Nessun cambio</option>
          <option value="portante">portante</option>
          <option value="strutturale">strutturale</option>
          <option value="laterale">laterale</option>
          <option value="trasversale">trasversale</option>
        </select>
      </div>

      <div class="editorial-feedback-row">
        <label for="notes" class="editorial-feedback-label">
          Note per la redazione
        </label>
        <textarea
          id="notes"
          name="notes"
          class="editorial-feedback-textarea"
          rows={3}
        />
      </div>

      <input type="hidden" id="wp_id" name="wp_id" value={wpId ?? ''} />
      <input type="hidden" id="title" name="title" value={title} />
      <input
        type="hidden"
        id="current_role"
        name="current_role"
        value={currentRole ?? ''}
      />
      <input type="hidden" id="url" name="url" value={url} />

      <div class="editorial-feedback-row editorial-feedback-actions">
        <button type="submit" class="editorial-feedback-submit">
          Invia
        </button>
        <p id="feedback-status" class="editorial-feedback-status" hidden></p>
      </div>
    </form>
  </aside>

<script>
  const ENDPOINT = 'https://script.google.com/macros/s/AKfycbyr5pblqyaH-AziRg3rhJBs8znL1qWs2smo15ksP8ePezZgFEDhdCHJoloKkMRbQF9xJA/exec';

  function initEditorialFeedback() {
    // Mostra il box solo se ?redazione=1 è nell'URL
    const box = document.getElementById('editorial-feedback-box');
    if (!box) return;
    const isRedazione = new URLSearchParams(window.location.search).has('redazione');
    box.hidden = !isRedazione;
    if (!isRedazione) return;

    const form = document.getElementById('editorial-feedback-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('feedback-status');
    const submitBtn = form?.querySelector<HTMLButtonElement>('.editorial-feedback-submit');
    if (!form) return;

    // Rimuovi listener precedente clonando il form
    const freshForm = form.cloneNode(true) as HTMLFormElement;
    form.replaceWith(freshForm);
    const freshBtn = freshForm.querySelector<HTMLButtonElement>('.editorial-feedback-submit');
    const freshStatus = document.getElementById('feedback-status');

    freshForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(freshForm);
      const params = new URLSearchParams({
        wp_id:         String(fd.get('wp_id') ?? ''),
        title:         String(fd.get('title') ?? ''),
        current_role:  String(fd.get('current_role') ?? ''),
        proposed_role: String(fd.get('proposed_role') ?? ''),
        notes:         String(fd.get('notes') ?? ''),
        url:           String(fd.get('url') ?? ''),
      });

      if (freshStatus) { freshStatus.textContent = 'Invio in corso…'; freshStatus.hidden = false; }
      if (freshBtn) freshBtn.disabled = true;

      try {
        // GET con params: pattern standard e affidabile per Apps Script doGet()
        await fetch(`${ENDPOINT}?${params.toString()}`, { mode: 'no-cors' });
        freshForm.reset();
        if (freshStatus) {
          freshStatus.textContent = '✓ Inviato con successo!';
          setTimeout(() => { if (freshStatus) freshStatus.hidden = true; }, 5000);
        }
      } catch {
        if (freshStatus) { freshStatus.textContent = 'Errore di rete — riprova.'; }
      } finally {
        if (freshBtn) setTimeout(() => { freshBtn.disabled = false; }, 3000);
      }
    });
  }

  document.addEventListener('astro:page-load', initEditorialFeedback);
  if (document.readyState !== 'loading') initEditorialFeedback();
</script>

<style>
  .editorial-feedback {
    margin-top: 2.5rem;
    padding: 0.75rem 1rem 0.9rem;
    background: #fffbe6;
    border: 1px dashed #e0c94f;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, monospace;
    font-size: 0.8rem;
    color: var(--text-secondary, #5c5c5c);
  }

  .editorial-feedback-header {
    margin-bottom: 0.35rem;
  }

  .editorial-feedback-title {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: #b38b00;
  }

  .editorial-feedback-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .editorial-feedback-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.15rem;
    color: #6b5a00;
  }

  .editorial-feedback-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .editorial-feedback-select {
    max-width: 14rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid #e0c94f;
    border-radius: 3px;
    background: #fffdf0;
    font: inherit;
    font-size: 0.8rem;
  }

  .editorial-feedback-textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid #e0c94f;
    border-radius: 3px;
    background: #fffdf0;
    font: inherit;
    font-size: 0.8rem;
    resize: vertical;
  }

  .editorial-feedback-actions {
    margin-top: 0.4rem;
    align-items: center;
    gap: 0.5rem;
  }

  .editorial-feedback-submit {
    align-self: flex-start;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid #d3b53e;
    background: #fff5b0;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: #6b5a00;
    cursor: pointer;
  }

  .editorial-feedback-submit:hover {
    background: #ffef8a;
  }

  .editorial-feedback-status {
    font-size: 0.75rem;
    color: #6b5a00;
  }
</style>
