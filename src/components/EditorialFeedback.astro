---
import type { Locale } from '../utils/i18n';
import { t } from '../utils/i18n';

interface Props {
  wpId?: number | string | null;
  title: string;
  currentRole?: string | null;
  url: string;
  articoloId?: string | null;
  /** Allinea testi staff al locale articolo (EN = DOM in inglese). */
  lang?: Locale;
}

const { wpId, title, currentRole, url, articoloId, lang: langProp } = Astro.props;
const lang: Locale = langProp ?? 'it';
const directusEditUrl = articoloId
  ? `https://cms.ombreeluci.it/admin/content/articoli/${articoloId}`
  : 'https://cms.ombreeluci.it/admin/content/articoli';
---

<!-- Bottone modifica Directus (sempre nel DOM, mostrato via JS) -->
<a
  id="directus-edit-btn"
  href={directusEditUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="directus-edit-btn"
  hidden
>
  ✏ {t(lang, 'editorial_directus_edit')}
</a>

<aside class="editorial-feedback" aria-label={t(lang, 'editorial_aria')} id="editorial-feedback-box">
  <div class="editorial-feedback-header">
    <span class="editorial-feedback-title">{t(lang, 'editorial_box_title')}</span>
  </div>
  <form
    id="editorial-feedback-form"
    class="editorial-feedback-form"
    data-msg-sending={t(lang, 'editorial_sending')}
    data-msg-sent={t(lang, 'editorial_sent')}
    data-msg-error={t(lang, 'editorial_network_error')}
  >
    <div class="editorial-feedback-row">
      <label for="proposed_role" class="editorial-feedback-label">{t(lang, 'editorial_proposed_role')}</label>
      <select id="proposed_role" name="proposed_role" class="editorial-feedback-select">
        <option value="">{t(lang, 'editorial_role_none')}</option>
        <option value="portante">{t(lang, 'editorial_role_portante')}</option>
        <option value="strutturale">{t(lang, 'editorial_role_strutturale')}</option>
        <option value="laterale">{t(lang, 'editorial_role_laterale')}</option>
        <option value="trasversale">{t(lang, 'editorial_role_trasversale')}</option>
      </select>
    </div>
    <div class="editorial-feedback-row">
      <label for="notes" class="editorial-feedback-label">{t(lang, 'editorial_notes')}</label>
      <textarea id="notes" name="notes" class="editorial-feedback-textarea" rows={3}></textarea>
    </div>
    <input type="hidden" name="wp_id" value={wpId ?? ''} />
    <input type="hidden" name="title" value={title} />
    <input type="hidden" name="current_role" value={currentRole ?? ''} />
    <input type="hidden" name="url" value={url} />
    <div class="editorial-feedback-row editorial-feedback-actions">
      <button type="submit" class="editorial-feedback-submit">{t(lang, 'editorial_submit')}</button>
      <p id="feedback-status" class="editorial-feedback-status" hidden></p>
    </div>
  </form>
</aside>

<script>
  const ENDPOINT = 'https://script.google.com/macros/s/AKfycbyXki9Wi36EGXhdmxnqVVe9FiDdV4PraC0fkkM_eBJS4sGp0xyZZft6kPJm0R_koUiKCw/exec';

  // Cached per tutta la sessione (ViewTransitions non ricarica il modulo)
  let _authChecked = false;
  let _isAuthenticated = false;

  async function checkDirectusAuth(): Promise<boolean> {
    if (_authChecked) return _isAuthenticated;
    try {
      const r = await fetch('https://cms.ombreeluci.it/users/me', {
        credentials: 'include',
      });
      _isAuthenticated = r.ok;
    } catch {
      _isAuthenticated = false;
    }
    _authChecked = true;
    return _isAuthenticated;
  }

  async function initEditorialFeedback() {
    const isAuth = await checkDirectusAuth();

    // Edit button
    const editBtn = document.getElementById('directus-edit-btn');
    if (editBtn) editBtn.hidden = !isAuth;

    // Editorial box: sempre visibile, anche senza sessione Directus.
    // Serve alla redazione per lavorare via endpoint feedback esterno.
    const box = document.getElementById('editorial-feedback-box');
    if (!box) return;
    box.hidden = false;

    const form = document.getElementById('editorial-feedback-form') as HTMLFormElement | null;
    if (!form) return;

    const msgSending = form.dataset.msgSending ?? '';
    const msgSent = form.dataset.msgSent ?? '';
    const msgError = form.dataset.msgError ?? '';

    // Clona per rimuovere eventuali listener precedenti (ViewTransitions)
    const fresh = form.cloneNode(true) as HTMLFormElement;
    form.replaceWith(fresh);
    const freshBtn = fresh.querySelector<HTMLButtonElement>('.editorial-feedback-submit');
    const freshStatus = fresh.querySelector<HTMLParagraphElement>('#feedback-status');

    fresh.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(fresh);
      const qs = new URLSearchParams({
        wp_id:         String(fd.get('wp_id') ?? ''),
        title:         String(fd.get('title') ?? ''),
        current_role:  String(fd.get('current_role') ?? ''),
        proposed_role: String(fd.get('proposed_role') ?? ''),
        notes:         String(fd.get('notes') ?? ''),
        url:           String(fd.get('url') ?? ''),
      });

      if (freshStatus) { freshStatus.textContent = msgSending; freshStatus.hidden = false; }
      if (freshBtn) freshBtn.disabled = true;

      try {
        await fetch(`${ENDPOINT}?${qs.toString()}`, { mode: 'no-cors' });
        fresh.reset();
        if (freshStatus) {
          freshStatus.textContent = msgSent;
          setTimeout(() => { if (freshStatus) freshStatus.hidden = true; }, 4000);
        }
      } catch {
        if (freshStatus) freshStatus.textContent = msgError;
      } finally {
        if (freshBtn) setTimeout(() => { freshBtn.disabled = false; }, 3000);
      }
    });
  }

  document.addEventListener('astro:page-load', () => { initEditorialFeedback(); });
  if (document.readyState !== 'loading') initEditorialFeedback();
</script>

<style>
  .directus-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding: 0.4rem 0.9rem;
    background: #1a1a2e;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .directus-edit-btn:hover { opacity: 1; }

  .editorial-feedback {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem 0.9rem;
    background: #fffbe6;
    border: 1px dashed #e0c94f;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, monospace;
    font-size: 0.8rem;
    color: var(--text-secondary, #5c5c5c);
  }

  .editorial-feedback-header { margin-bottom: 0.35rem; }

  .editorial-feedback-title {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: #b38b00;
  }

  .editorial-feedback-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .editorial-feedback-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.15rem;
    color: #6b5a00;
  }

  .editorial-feedback-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .editorial-feedback-select {
    max-width: 14rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid #e0c94f;
    border-radius: 3px;
    background: #fffdf0;
    font: inherit;
    font-size: 0.8rem;
  }

  .editorial-feedback-textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid #e0c94f;
    border-radius: 3px;
    background: #fffdf0;
    font: inherit;
    font-size: 0.8rem;
    resize: vertical;
  }

  .editorial-feedback-actions {
    margin-top: 0.4rem;
    align-items: center;
    gap: 0.5rem;
    flex-direction: row;
  }

  .editorial-feedback-submit {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid #d3b53e;
    background: #fff5b0;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: #6b5a00;
    cursor: pointer;
  }

  .editorial-feedback-submit:hover { background: #ffef8a; }

  .editorial-feedback-status {
    font-size: 0.75rem;
    color: #6b5a00;
  }
</style>
