---
interface Props {
  titoloDiario: string;
  diarioHref: string;
  nomeAutore: string;
  hubHref: string;
  hubLabel: string;
  byLabel: string;
}

const { titoloDiario, diarioHref, nomeAutore, hubHref, hubLabel, byLabel } = Astro.props;
---

<div class="diario-article-fascia">
  <div class="diario-fascia-inner">
    <a href={hubHref} class="diario-fascia-hub">
      <span aria-hidden="true">📖</span>
      {hubLabel}
    </a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    <a href={diarioHref} class="diario-fascia-diary">{titoloDiario}</a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    <span class="diario-fascia-author">{byLabel} {nomeAutore}</span>
  </div>
</div>

<style>
  .diario-article-fascia {
    background-color: var(--diari-bg, #f0f7ff);
    width: 100%;
  }

  .diario-fascia-inner {
    max-width: 850px;
    margin: 0 auto;
    padding: 0.55rem 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.8125rem;
    line-height: 1;
  }

  .diario-fascia-hub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .diario-fascia-hub:hover {
    text-decoration: underline;
  }

  .diario-fascia-sep {
    color: var(--text-secondary);
    padding: 0 0.05rem;
  }

  .diario-fascia-diary {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
    font-family: 'Ultra', Georgia, serif;
    font-size: 0.875rem;
  }

  .diario-fascia-diary:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .diario-fascia-author {
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .diario-fascia-inner {
      padding: 0.55rem 1.25rem;
    }
  }
</style>
