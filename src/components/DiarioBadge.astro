---
interface Props {
  titoloDiario: string;
  diarioHref: string;
  nomeAutore: string;
  hubHref: string;
  hubLabel: string;
  byLabel: string;
  autoreFotoUrl?: string;
}

const { titoloDiario, diarioHref, nomeAutore, hubHref, hubLabel, byLabel, autoreFotoUrl } = Astro.props;
---

<div class="diario-article-fascia">
  <div class="diario-fascia-inner">
    <a href={hubHref} class="diario-fascia-hub">
      <img src="/images/diari/icon-diari.svg" alt="" aria-hidden="true" class="diario-fascia-icon" width="18" height="18" />
      {hubLabel}
    </a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    <a href={diarioHref} class="diario-fascia-diary">{titoloDiario}</a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    {autoreFotoUrl && (
      <img
        src={autoreFotoUrl}
        alt={nomeAutore}
        class="diario-fascia-foto"
        width="28"
        height="28"
        loading="lazy"
      />
    )}
    <span class="diario-fascia-author">{byLabel} {nomeAutore}</span>
  </div>
</div>

<style>
  .diario-article-fascia {
    background-color: var(--diari-bg, #f0f7ff);
    width: 100%;
  }

  .diario-fascia-inner {
    max-width: 850px;
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.875rem;
  }

  .diario-fascia-hub {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .diario-fascia-hub:hover {
    text-decoration: underline;
  }

  .diario-fascia-icon {
    flex-shrink: 0;
    display: block;
  }

  .diario-fascia-sep {
    color: var(--text-secondary);
    padding: 0 0.1rem;
  }

  .diario-fascia-diary {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
    font-family: 'Ultra', Georgia, serif;
    font-size: 0.9375rem;
  }

  .diario-fascia-diary:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .diario-fascia-foto {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.35rem;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .diario-fascia-author {
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .diario-fascia-inner {
      padding: 0.75rem 1.25rem;
    }
  }
</style>
