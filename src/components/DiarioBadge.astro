---
import IconDiari from './IconDiari.astro';

interface Props {
  titoloDiario: string;
  diarioHref: string;
  nomeAutore: string;
  hubHref: string;
  hubLabel: string;
  byLabel: string;
  autoreFotoUrl?: string;
}

const { titoloDiario, diarioHref, nomeAutore, hubHref, hubLabel, byLabel, autoreFotoUrl } = Astro.props;
---

<div class="diario-article-fascia">
  <div class="diario-fascia-inner">
    <a href={hubHref} class="diario-fascia-hub">
      <IconDiari size={16} />
      {hubLabel}
    </a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    {autoreFotoUrl && (
      <img
        src={autoreFotoUrl}
        alt={nomeAutore}
        class="diario-fascia-foto"
        width="48"
        height="48"
        loading="lazy"
      />
    )}
    <a href={diarioHref} class="diario-fascia-diary">{titoloDiario}</a>
    <span class="diario-fascia-sep" aria-hidden="true"> · </span>
    <span class="diario-fascia-author">{byLabel} {nomeAutore}</span>
  </div>
</div>

<style>
  .diario-article-fascia {
    background-color: var(--diari-bg, #f0f7ff);
    width: 100%;
    overflow: visible;
  }

  .diario-fascia-inner {
    max-width: 850px;
    margin: 0 auto;
    padding: 0.6rem 2rem 0;
    display: flex;
    align-items: flex-end;
    flex-wrap: nowrap;
    gap: 0;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.875rem;
    min-height: 48px;
  }

  .diario-fascia-hub {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding-bottom: 0.6rem;
    white-space: nowrap;
  }

  .diario-fascia-hub:hover {
    text-decoration: underline;
  }

  .diario-fascia-sep {
    color: var(--text-secondary);
    padding: 0 0.1rem 0.6rem;
    white-space: nowrap;
  }

  .diario-fascia-foto {
    width: 48px;
    height: 48px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
    margin-right: 0.45rem;
    align-self: flex-end;
  }

  .diario-fascia-diary {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-family: 'Ultra', Georgia, serif;
    font-size: 1rem;
    padding-bottom: 0.6rem;
    white-space: nowrap;
  }

  .diario-fascia-diary:hover {
    text-decoration: underline;
  }

  .diario-fascia-author {
    color: var(--text-secondary);
    padding-bottom: 0.6rem;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .diario-fascia-inner {
      padding: 0.5rem 1.25rem 0;
    }
  }
</style>
