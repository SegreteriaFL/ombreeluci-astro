---
import IssueCard from './IssueCard.astro';
import { COPERTINA_IMG_ONERROR, PLACEHOLDER_COPERTINA } from '../lib/directus';
import { t, localizeIssuePeriodLabel, type Locale } from '../utils/i18n';

interface ArticleMeta {
  slug: string;
  title: string;
  author: string;
  authorAvatar?: string | null;
  date: Date;
  image: string | null;
  sommario?: string;
  categoria_menu?: string;
  issue: string | null;
}

interface DiarioCard {
  diarista: { nome: string; authorSlug: string; diarioSlug: string };
  meta: ArticleMeta;
  fotoUrl: string;
}

interface ExploreItem {
  catLabel: string;
  catUrl: string;
  meta: ArticleMeta;
}

interface NumeroRecord {
  id_numero: string;
  tipo_rivista: string;
  numero_progressivo: number;
  anno_pubblicazione: number;
  display_title?: string;
  titolo_numero?: string;
  periodo_label?: string | null;
  sommario_lancio?: string | null;
  seo_description?: string | null;
  copertina_url?: string | null;
}

interface Props {
  lang: Locale;
  featuredPool: ArticleMeta[];
  latestArticles: ArticleMeta[];
  diariCards: DiarioCard[];
  closeUpArticles: ArticleMeta[];
  testimonianze: ArticleMeta[];
  exploreItems: ExploreItem[];
  numeriPerCarousel: NumeroRecord[];
  ultimoNumero: NumeroRecord | null;
  issueSlug: string;
}

const {
  lang,
  featuredPool,
  latestArticles,
  diariCards,
  closeUpArticles,
  testimonianze,
  exploreItems,
  numeriPerCarousel,
  ultimoNumero,
  issueSlug,
} = Astro.props;

const articleBasePath = lang === 'en' ? '/en' : '/it';
const dateLocale = lang === 'en' ? 'en-US' : 'it-IT';

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
}

function formatRelative(d: Date): string {
  const days = Math.floor((new Date().getTime() - d.getTime()) / 86400000);
  if (lang === 'en') {
    if (days < 1) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 7) return `${days} days ago`;
    if (days < 30) { const w = Math.floor(days / 7); return w === 1 ? 'a week ago' : `${w} weeks ago`; }
    if (days < 365) { const m = Math.floor(days / 30); return m === 1 ? 'a month ago' : `${m} months ago`; }
    const y = Math.floor(days / 365); return y === 1 ? 'a year ago' : `${y} years ago`;
  }
  if (days < 1) return 'oggi';
  if (days === 1) return 'ieri';
  if (days < 7) return `${days} giorni fa`;
  if (days < 30) { const w = Math.floor(days / 7); return w === 1 ? 'una settimana fa' : `${w} settimane fa`; }
  if (days < 365) { const m = Math.floor(days / 30); return m === 1 ? 'un mese fa' : `${m} mesi fa`; }
  const y = Math.floor(days / 365); return y === 1 ? 'un anno fa' : `${y} anni fa`;
}

const archiveBasePath = lang === 'en' ? '/en/archive' : '/it/archivio';
const diariesPath = lang === 'en' ? '/en/authors' : '/sezioni/diari';
const supportPath = lang === 'en' ? '/en/support' : '/it/sostienici';
const contactPath = lang === 'en' ? '/en/contact' : '/it/chi-siamo/contatti';

const issuePeriodLabel = ultimoNumero
  ? localizeIssuePeriodLabel(ultimoNumero.periodo_label ?? null, lang)
  : null;
---

<main class="site-main home-page">

  <!-- ══════════════════════════════════════════════════════════
       1. HERO SLIDER
       ══════════════════════════════════════════════════════════ -->
  <section class="home-hero-slider" aria-label={lang === 'en' ? 'Featured articles' : 'Articoli in evidenza'}>
    {featuredPool.map((meta, i) => (
      <div
        class:list={['hero-slide', { 'hero-slide--active': i === 0 }]}
        data-slide={i}
        aria-hidden={i !== 0 ? 'true' : undefined}
      >
        <div
          class="hero-slide-bg"
          style={`background-image:url(${meta.image || PLACEHOLDER_COPERTINA})`}
        />
        <div class="hero-slide-overlay" />
        <div class="hero-slide-content">
          <div class="hero-slide-meta">
            {meta.authorAvatar
              ? <img src={meta.authorAvatar} alt="" class="hero-avatar" loading={i === 0 ? 'eager' : 'lazy'} width="40" height="40" />
              : <span class="hero-avatar hero-avatar--placeholder">{meta.author.charAt(0)}</span>
            }
            <span class="hero-byline-text">
              {lang === 'en' ? 'By' : 'Di'} <strong>{meta.author}</strong>
              {meta.categoria_menu && (
                <> &middot; <span class="hero-cat-label">{meta.categoria_menu.replace(/-/g, ' ')}</span></>
              )}
            </span>
          </div>
          <h2 class="hero-title">
            <a href={`${articleBasePath}/${meta.slug}`} class="hero-title-link" tabindex={i !== 0 ? -1 : undefined}>
              {meta.title}
            </a>
          </h2>
          <a
            href={`${articleBasePath}/${meta.slug}`}
            class="hero-cta"
            tabindex={i !== 0 ? -1 : undefined}
          >
            {lang === 'en' ? 'Read Article' : 'Leggi l\'articolo'}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    ))}

    <!-- Tab strip navigazione — struttura Nectar: li direttamente interattivo -->
    <nav class="hero-controls" aria-label={lang === 'en' ? 'Slide navigation' : 'Navigazione slide'}>
      <ul class="hero-controls-list" role="tablist" style={`--hero-tab-count:${featuredPool.length}`}>
        {featuredPool.map((meta, i) => (
          <li
            class:list={['hero-tab', { 'hero-tab--active': i === 0 }]}
            data-slide={i}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={meta.title}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="hero-tab-title">{meta.title}</span>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       2. TAGLINE + FEATURED + RECENTI (sotto lo slider)
       ══════════════════════════════════════════════════════════ -->
  <section class="home-hero-section">
    <div class="home-container">
      <div class="home-hero-grid">

        <div>
          <p class="home-tagline">{t(lang, 'home_tagline')}</p>
          <div id="hero-pool">
            {featuredPool.map((meta, i) => (
              <article data-hero-candidate style={i > 0 ? 'display:none' : ''}>
                <a href={`${articleBasePath}/${meta.slug}`}>
                  <figure class="home-featured-figure">
                    <img
                      src={meta.image || PLACEHOLDER_COPERTINA}
                      alt=""
                      loading="lazy"
                      width="800" height="450"
                      data-copertina-fallback
                      onerror={COPERTINA_IMG_ONERROR}
                    />
                  </figure>
                  <p class="home-cat">{meta.categoria_menu || t(lang, 'badge_online')}</p>
                  <h2 class="home-featured-title">{meta.title}</h2>
                  {meta.sommario && <p class="home-featured-deck">{meta.sommario}</p>}
                  <p class="home-byline">
                    {lang === 'en' ? 'By' : 'Di'} <strong>{meta.author}</strong> · {formatDate(meta.date)}
                  </p>
                </a>
              </article>
            ))}
          </div>
        </div>

        <aside class="home-recenti">
          <h2 class="section-title">{t(lang, 'home_section_recent')}</h2>
          {latestArticles.map((meta) => (
            <a href={`${articleBasePath}/${meta.slug}`} class="home-recenti-item">
              <div class="home-recenti-thumb">
                <img src={meta.image || PLACEHOLDER_COPERTINA} alt="" loading="lazy"
                  data-copertina-fallback onerror={COPERTINA_IMG_ONERROR} />
              </div>
              <div>
                <p class="home-cat-small">{meta.categoria_menu || t(lang, 'badge_online')}</p>
                <h3 class="home-recenti-title">{meta.title}</h3>
                <p class="home-byline-small">{lang === 'en' ? 'By' : 'Di'} {meta.author}</p>
              </div>
            </a>
          ))}
        </aside>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       3. DA VICINO / CLOSE UP
       ══════════════════════════════════════════════════════════ -->
  <section class="home-davicino-section" aria-label={t(lang, 'home_section_close_up')}>
    <div class="home-container">

      <div class="home-section-intro">
        <h2 class="home-section-heading">{t(lang, 'home_section_close_up')}</h2>
        <p class="home-section-sub">{t(lang, 'home_section_close_up_sub')}</p>
      </div>

      <div class="home-davicino-grid">

        <!-- Colonna sinistra: diari (IT) o articoli recenti (EN) -->
        <div class="home-diari-col">
          <div class="home-diari-grid">
            {diariCards.length > 0
              ? diariCards.map(({ diarista, meta, fotoUrl }) => (
                  <a href={`${articleBasePath}/${meta.slug}`} class="home-diario-card">
                    <div class="home-diario-avatar">
                      {fotoUrl
                        ? <img src={fotoUrl} alt={diarista.nome} loading="lazy" />
                        : <div class="home-diario-avatar-placeholder">{diarista.nome.charAt(0)}</div>
                      }
                    </div>
                    <p class="home-diario-nome">{diarista.nome}</p>
                    <h3 class="home-diario-titolo">{meta.title}</h3>
                    <p class="home-diario-date">{formatRelative(meta.date)}</p>
                  </a>
                ))
              : closeUpArticles.map((meta) => (
                  <a href={`${articleBasePath}/${meta.slug}`} class="home-diario-card">
                    <div class="home-diario-avatar">
                      <div class="home-diario-avatar-placeholder">{meta.author.charAt(0)}</div>
                    </div>
                    <p class="home-diario-nome">{meta.author}</p>
                    <h3 class="home-diario-titolo">{meta.title}</h3>
                    <p class="home-diario-date">{formatRelative(meta.date)}</p>
                  </a>
                ))
            }
          </div>
          <a href={diariesPath} class="home-link-more">{t(lang, 'home_section_all_stories')}</a>
        </div>

        <!-- Colonna destra: testimonianze + CTA -->
        <div class="home-testi-col">
          {testimonianze.map((meta) => (
            <a href={`${articleBasePath}/${meta.slug}`} class="home-testi-item">
              {meta.image && (
                <div class="home-testi-img">
                  <img
                    src={meta.image}
                    alt=""
                    loading="lazy"
                    data-copertina-fallback
                    onerror={COPERTINA_IMG_ONERROR}
                  />
                </div>
              )}
              <div class="home-testi-body">
                <p class="home-cat">{lang === 'en' ? 'Testimonial' : 'Testimonianza'}</p>
                <h3 class="home-testi-title">{meta.title}</h3>
                <p class="home-byline-small">{lang === 'en' ? 'By' : 'Di'} {meta.author} · {formatDate(meta.date)}</p>
              </div>
            </a>
          ))}
          <div class="home-testi-cta">
            <p>{t(lang, 'home_testi_cta_text')}</p>
            <a href="mailto:ombreeluci@fedeeluce.it" class="home-testi-cta-link">{t(lang, 'home_testi_cta_link')}</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       3. ESPLORA / EXPLORE
       ══════════════════════════════════════════════════════════ -->
  <section class="home-esplora-section" aria-label={t(lang, 'home_section_explore')}>
    <div class="home-container">
      <div class="home-section-intro">
        <h2 class="home-section-heading">{t(lang, 'home_section_explore')}</h2>
        <p class="home-section-sub">{t(lang, 'home_section_explore_sub')}</p>
      </div>
      <div class="home-esplora-grid">
        {exploreItems.map(({ catLabel, catUrl, meta }) => (
          <a href={catUrl} class="home-esplora-card">
            <div class="home-esplora-img">
              <img
                src={meta.image || PLACEHOLDER_COPERTINA}
                alt=""
                loading="lazy"
                data-copertina-fallback
                onerror={COPERTINA_IMG_ONERROR}
              />
            </div>
            <div class="home-esplora-body">
              <p class="home-esplora-cat">{catLabel}</p>
              <h3 class="home-esplora-title">{meta.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       4. LA RIVISTA / THE MAGAZINE
       ══════════════════════════════════════════════════════════ -->
  <section class="home-rivista-section" aria-label={t(lang, 'home_section_magazine') || 'La rivista'}>
    <div class="home-container">
      {ultimoNumero && (
        <div class="home-ultimo-numero">
          <div>
            <p class="home-rivista-eyebrow">{t(lang, 'home_magazine_eyebrow')}</p>
            <div class="home-rivista-riga" aria-hidden="true" />
            <p class="home-rivista-meta">
              {issuePeriodLabel ?? ultimoNumero.anno_pubblicazione} · n.{ultimoNumero.numero_progressivo}
            </p>
            <h3 class="home-rivista-titolo">
              {ultimoNumero.titolo_numero ?? `Ombre e Luci n. ${ultimoNumero.numero_progressivo}`}
            </h3>
            {(ultimoNumero.sommario_lancio ?? ultimoNumero.seo_description) && (
              <p class="home-rivista-sommario">
                {((ultimoNumero.sommario_lancio ?? ultimoNumero.seo_description ?? '') as string).slice(0, 220)}
                {((ultimoNumero.sommario_lancio ?? ultimoNumero.seo_description ?? '') as string).length > 220 ? '…' : ''}
              </p>
            )}
            <div class="home-rivista-actions">
              <a href={issueSlug ? `${archiveBasePath}/${issueSlug}` : archiveBasePath} class="home-rivista-cta">
                {t(lang, 'home_magazine_discover')}
              </a>
              <a href={archiveBasePath} class="home-rivista-link">{t(lang, 'home_magazine_archive')}</a>
            </div>
          </div>
          <div class="home-rivista-cover-col">
            {ultimoNumero.copertina_url ? (
              <a href={issueSlug ? `${archiveBasePath}/${issueSlug}` : archiveBasePath}>
                <img
                  src={ultimoNumero.copertina_url}
                  alt=""
                  loading="lazy"
                  width="240"
                  class="home-rivista-cover"
                />
              </a>
            ) : null}
          </div>
        </div>
      )}
    </div>

    <!-- Carousel -->
    {numeriPerCarousel.length > 0 && (
      <div class="home-archivio-strip">
        <div class="home-container">
          <h3 class="section-title">{t(lang, 'home_magazine_all_issues')}</h3>
          <div class="home-carousel-wrap">
            <button type="button" class="home-carousel-btn home-carousel-prev" aria-label="Previous">
              <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <path d="M8 2 L4 6 L8 10"/>
              </svg>
            </button>
            <div class="home-carousel-track-wrap">
              <div class="home-carousel-track" id="home-carousel-track">
                {numeriPerCarousel.map((n) => (
                  <div class="home-carousel-item">
                    <IssueCard
                      cover_url={n.copertina_url ?? undefined}
                      titolo_numero={n.titolo_numero ?? n.display_title ?? `Ombre e Luci n. ${n.numero_progressivo}`}
                      numero={n.numero_progressivo ?? 0}
                      anno={n.anno_pubblicazione ?? 0}
                      periodo_label={n.periodo_label ?? undefined}
                      tipo_rivista={n.tipo_rivista ?? 'ombre_e_luci'}
                      id_numero={n.id_numero ?? ''}
                      lang={lang}
                    />
                  </div>
                ))}
              </div>
            </div>
            <button type="button" class="home-carousel-btn home-carousel-next" aria-label="Next">
              <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <path d="M4 2 L8 6 L4 10"/>
              </svg>
            </button>
          </div>
          <p style="margin-top: 0.75rem;">
            <a href={archiveBasePath} class="home-link-more">{t(lang, 'home_magazine_archive_link')}</a>
          </p>
        </div>
      </div>
    )}
  </section>

  <!-- ══════════════════════════════════════════════════════════
       5. UNISCITI / GET INVOLVED
       ══════════════════════════════════════════════════════════ -->
  <section class="home-unisciti-section" aria-label={t(lang, 'home_section_join')}>
    <div class="home-container">
      <div class="home-section-intro">
        <h2 class="home-section-heading">{t(lang, 'home_section_join')}</h2>
        <p class="home-section-sub">{t(lang, 'home_section_join_sub')}</p>
      </div>
      <div class="home-unisciti-grid">

        <div class="home-unisciti-card">
          <div class="home-unisciti-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3 class="home-unisciti-title">{t(lang, 'home_join_support_title')}</h3>
          <p class="home-unisciti-text">{t(lang, 'home_join_support_text')}</p>
          <a href={supportPath} class="home-unisciti-btn">{t(lang, 'home_join_support_btn')}</a>
        </div>

        <div class="home-unisciti-card">
          <div class="home-unisciti-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h3 class="home-unisciti-title">{t(lang, 'home_join_story_title')}</h3>
          <p class="home-unisciti-text">{t(lang, 'home_join_story_text')}</p>
          <a href="mailto:ombreeluci@fedeeluce.it" class="home-unisciti-btn">{t(lang, 'home_join_story_btn')}</a>
        </div>

        <div class="home-unisciti-card">
          <div class="home-unisciti-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="home-unisciti-title">{t(lang, 'home_join_help_title')}</h3>
          <p class="home-unisciti-text">{t(lang, 'home_join_help_text')}</p>
          <a href={contactPath} class="home-unisciti-btn">{t(lang, 'home_join_help_btn')}</a>
        </div>

      </div>
      <p class="home-newsletter-row">
        {t(lang, 'home_newsletter_row')}
        <a
          href="https://ombreeluci.us17.list-manage.com/subscribe?u=00c5dad63480d9601563b5692&id=efd099264d"
          target="_blank"
          rel="noopener noreferrer"
        >{t(lang, 'home_newsletter_link')}</a>
      </p>
    </div>
  </section>

</main>

<script>
  // Rotazione random articolo featured nella sezione sotto lo slider
  (function () {
    const candidates = document.querySelectorAll<HTMLElement>('[data-hero-candidate]');
    if (candidates.length > 1) {
      const idx = Math.floor(Math.random() * candidates.length);
      candidates.forEach((c, i) => { c.style.display = i === idx ? '' : 'none'; });
    }
  })();

  // ── Hero slider ──────────────────────────────────────────────
  (function () {
    const slider = document.querySelector('.home-hero-slider');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
    const tabs   = Array.from(slider.querySelectorAll<HTMLElement>('.hero-tab'));
    if (slides.length < 2) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(idx: number) {
      const prev = current;
      current = (idx + slides.length) % slides.length;
      if (prev === current) return;

      // Disattiva slide precedente
      slides[prev].classList.remove('hero-slide--active');
      slides[prev].setAttribute('aria-hidden', 'true');
      slides[prev].querySelectorAll<HTMLElement>('a').forEach(el => el.setAttribute('tabindex', '-1'));

      // Trans-out: collasso istantaneo progress bar
      const prevTab = tabs[prev];
      prevTab.classList.add('hero-tab--trans-out');
      prevTab.classList.remove('hero-tab--active');
      prevTab.setAttribute('aria-selected', 'false');
      prevTab.setAttribute('tabindex', '-1');
      requestAnimationFrame(() => prevTab.classList.remove('hero-tab--trans-out'));

      // Attiva nuova slide
      slides[current].classList.add('hero-slide--active');
      slides[current].removeAttribute('aria-hidden');
      slides[current].querySelectorAll<HTMLElement>('[tabindex="-1"]').forEach(el => el.removeAttribute('tabindex'));

      // Forza reflow per riavviare animazione ::after
      const newTab = tabs[current];
      newTab.classList.remove('hero-tab--active');
      void newTab.offsetWidth;
      newTab.classList.add('hero-tab--active');
      newTab.setAttribute('aria-selected', 'true');
      newTab.setAttribute('tabindex', '0');
    }

    function startTimer() {
      timer = setInterval(() => goTo(current + 1), 5000);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { goTo(i); stopTimer(); startTimer(); });
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); goTo(i); stopTimer(); startTimer(); }
      });
    });

    slider.addEventListener('mouseenter', stopTimer);
    slider.addEventListener('mouseleave', startTimer);
    slider.addEventListener('touchstart', stopTimer, { passive: true });

    startTimer();
  })();

  // Carousel archivio
  (function () {
    const track = document.getElementById('home-carousel-track');
    const prev = document.querySelector<HTMLElement>('.home-carousel-prev');
    const next = document.querySelector<HTMLElement>('.home-carousel-next');
    if (!track || !prev || !next) return;
    const scroll = (180 + 20) * 2;
    prev.addEventListener('click', () => track.scrollBy({ left: -scroll, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: scroll, behavior: 'smooth' }));
    let iv = setInterval(() => track.scrollBy({ left: scroll, behavior: 'smooth' }), 4000);
    const stop = () => clearInterval(iv);
    track.addEventListener('mouseenter', stop);
    track.addEventListener('touchstart', stop, { passive: true });
  })();
</script>

