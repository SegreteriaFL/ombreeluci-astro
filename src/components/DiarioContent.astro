---
import { type Locale } from '../utils/i18n';
import ArticleCard from './ArticleCard.astro';
import { getMegaclusterForArticle, getLabels } from '../config/taxonomy.js';
import { getArticoloCopertinaSrc } from '../lib/directus';
import type { ArticoloFull } from '../lib/directus';

interface Props {
  lang: Locale;
  nomeAutore: string;
  titoloDiario: string;
  fotoUrl: string;
  descrizioneDiario: string;
  articoli: ArticoloFull[];
}

const { lang, nomeAutore, titoloDiario, fotoUrl, descrizioneDiario, articoli } = Astro.props;

const backHref = lang === 'en' ? '/en/sections/diaries/' : '/it/rubriche/diari/';
const backLabel = lang === 'en' ? 'THE DIARIES' : 'I DIARI';
const byLabel = lang === 'en' ? 'by' : 'di';
const emptyMsg = lang === 'en' ? 'No articles published for this diary yet.' : 'Nessun articolo ancora pubblicato per questo diario.';
const articleBasePath = lang === 'en' ? '/en' : '/it';
const articlesLabel = lang === 'en' ? `Articles from ${titoloDiario}` : `Articoli di ${titoloDiario}`;
---

<main class="site-main">
  <div class="diario-hero">
    <div class="container diario-hero-inner">
      <a href={backHref} class="diario-hub-link">
        <span aria-hidden="true">📖</span>
        {backLabel}
      </a>
      <div class="diario-hero-content">
        <div class="diario-hero-photo">
          {fotoUrl ? (
            <img src={fotoUrl} alt={nomeAutore} width="200" height="200" loading="eager" />
          ) : (
            <div class="diario-hero-placeholder" aria-hidden="true" />
          )}
        </div>
        <div class="diario-hero-text">
          <h1 class="diario-hero-title">{titoloDiario}</h1>
          <p class="diario-hero-author">{byLabel} {nomeAutore}</p>
          {descrizioneDiario && (
            <p class="diario-hero-bio">{descrizioneDiario}</p>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="container diario-articles">
    <section aria-label={articlesLabel}>
      {articoli.length > 0 ? (
        <div class="diario-articles-grid">
          {articoli.map((a) => {
            const { categoria_menu, ruolo_editoriale } = getMegaclusterForArticle(a);
            const { formal } = getLabels([], a);
            const articleDate = a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date();
            const articleImage = getArticoloCopertinaSrc(a);
            return (
              <ArticleCard
                title={a.titolo}
                slug={a.slug}
                categoriaMenu={categoria_menu ?? undefined}
                issue={a.numero_rivista?.id_numero ?? null}
                forma={formal}
                author={a.autore?.nome_completo ?? nomeAutore}
                date={articleDate}
                image={articleImage}
                ruoloEditoriale={ruolo_editoriale ?? undefined}
                basePath={articleBasePath}
                lang={lang}
              />
            );
          })}
        </div>
      ) : (
        <p class="diario-empty">{emptyMsg}</p>
      )}
    </section>
  </div>
</main>

<style>
  .diario-hero {
    background-color: var(--diari-bg, #f0f7ff);
    padding: 1.75rem 0 2.5rem;
    width: 100%;
  }

  .diario-hero-inner {
    /* container gestisce max-width */
  }

  .diario-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-color);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .diario-hub-link:hover {
    text-decoration: underline;
  }

  .diario-hero-content {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .diario-hero-photo {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-light, #f5f5f5);
    border: 3px solid #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .diario-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .diario-hero-placeholder {
    width: 100%;
    height: 100%;
    background: var(--border-color, #ddd);
  }

  .diario-hero-text {
    min-width: 0;
  }

  .diario-hero-title {
    font-family: 'Ultra', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--text-color);
    margin-bottom: 0.35rem;
    line-height: 1.1;
  }

  .diario-hero-author {
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    margin-top: 0;
  }

  .diario-hero-bio {
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-color);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 52ch;
    margin: 0;
  }

  .diario-articles {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .diario-articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .diario-empty {
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .diario-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .diario-hero {
      padding: 1.25rem 0 2rem;
    }

    .diario-hero-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .diario-hero-photo {
      margin: 0 auto;
    }

    .diario-hero-title {
      font-size: 2rem;
    }

    .diario-articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
