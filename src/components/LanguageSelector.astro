---
/**
 * LanguageSelector – switch IT | EN stile fedeeluce.it.
 * Se siamo su un articolo e esiste la versione nell'altra lingua (stesso wp_id), il link punta lì; altrimenti / (IT) o /blog/en (EN).
 */
import { getLangFromUrl } from '../utils/i18n';

interface Props {
  pathname: string;
  alternateArticleUrl?: string | null;
  lang?: 'it' | 'en';
}

const { pathname, alternateArticleUrl = null, lang: langProp } = Astro.props;
// lang prop ha precedenza su URL-based detection (necessario per articoli EN a /blog/slug senza prefisso /en/)
const lang = langProp ?? getLangFromUrl(pathname);

const hrefIt = lang === 'en' && alternateArticleUrl ? alternateArticleUrl : '/';
const hrefEn = lang === 'it' && alternateArticleUrl ? alternateArticleUrl : '/blog/en';
---

<div class="lang-selector" aria-label="Selezione lingua">
  <a href={hrefIt} class="lang-link" class:list={[lang === 'it' && 'is-active']}>IT</a>
  <span class="lang-sep" aria-hidden="true">|</span>
  <a href={hrefEn} class="lang-link" class:list={[lang === 'en' && 'is-active']}>EN</a>
</div>

<style>
  .lang-selector {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary, #5c5c5c);
  }

  .lang-link {
    color: inherit;
    text-decoration: none;
    padding: 0.2rem 0.1rem;
    transition: color 0.2s ease;
  }

  .lang-link:hover {
    color: var(--accent-color);
  }

  .lang-link.is-active {
    color: var(--accent-color);
    font-weight: 600;
  }

  .lang-sep {
    color: var(--text-secondary, #5c5c5c);
    opacity: 0.7;
    user-select: none;
  }
</style>

<script>
  function updateLangSelector() {
    const data = (window as any).__BLOG_PAGE_DATA__;
    // Su pagine articolo: usa lang da __BLOG_PAGE_DATA__ (affidabile anche per EN a /blog/slug-it)
    // Su altre pagine: fallback URL-based
    const isEn = data?.lang
      ? data.lang === 'en'
      : window.location.pathname.startsWith('/blog/en') || window.location.pathname.startsWith('/en/') || /\/en\//.test(window.location.pathname);

    document.querySelectorAll<HTMLAnchorElement>('.lang-link').forEach(link => {
      const isItLink = link.textContent?.trim() === 'IT';
      const isEnLink = link.textContent?.trim() === 'EN';
      link.classList.toggle('is-active', isItLink ? !isEn : isEn);

      // alternateArticleUrl = URL dell'articolo nell'ALTRA lingua
      const altUrl: string | null = data?.alternateArticleUrl ?? null;
      if (isItLink) {
        // Su EN con alternate → vai alla versione IT; altrimenti home
        link.href = (isEn && altUrl) ? altUrl : '/';
      }
      if (isEnLink) {
        // Su IT con alternate → vai alla versione EN; altrimenti /blog/en
        link.href = (!isEn && altUrl) ? altUrl : '/blog/en';
      }
    });
  }

  document.addEventListener('astro:page-load', updateLangSelector);
</script>
