---
/**
 * AutocompleteWidget — ricerca istantanea categorizzata (Articoli / Autori / Numeri).
 * Monta su desktop (≥768px); sul mobile l'overlay esistente gestisce la ricerca.
 * ALGOLIA-03: usa @algolia/autocomplete-js, nessun import statico nel frontmatter.
 */
import type { Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
  searchHref: string;
}

const { lang, searchHref } = Astro.props;
const appId     = import.meta.env.PUBLIC_ALGOLIA_APP_ID     ?? '';
const searchKey = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY ?? '';
---

<!-- No-JS fallback: form originale visibile senza JS -->
<form
  class="search-form"
  id="aa-fallback-form"
  action={searchHref}
  method="get"
  aria-label={lang === 'en' ? 'Search' : 'Cerca'}
>
  <label for="aa-fallback-input" class="search-label">
    {lang === 'en' ? 'Search' : 'Cerca nel sito'}
  </label>
  <input
    id="aa-fallback-input"
    type="search"
    name="q"
    placeholder={lang === 'en' ? 'Search articles, authors…' : 'Cerca articoli, autori…'}
    class="search-input"
    autocomplete="off"
  />
  <button type="submit" class="search-button" aria-label={lang === 'en' ? 'Search' : 'Cerca'}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
  </button>
</form>

<!-- Container autocomplete (popolato da JS, nascosto di default) -->
<div
  id="aa-container"
  class="search-form"
  style="display:none"
  data-lang={lang}
  data-search-href={searchHref}
  data-app-id={appId}
  data-search-key={searchKey}
></div>

<script>
  import { autocomplete, getAlgoliaResults } from '@algolia/autocomplete-js';
  import { algoliasearch } from 'algoliasearch';

  type Lang = 'it' | 'en';

  let acInstance: ReturnType<typeof autocomplete> | null = null;

  const LABELS = {
    it: {
      articoli: 'Articoli',
      autori: 'Autori',
      numeri: 'Numeri della rivista',
      seeAll: 'Vedi tutti i risultati',
      placeholder: 'Cerca articoli, autori, numeri…',
      noResults: 'Nessun risultato per',
      minChars: 'Digita almeno 2 caratteri',
    },
    en: {
      articoli: 'Articles',
      autori: 'Authors',
      numeri: 'Magazine issues',
      seeAll: 'See all results',
      placeholder: 'Search articles, authors, issues…',
      noResults: 'No results for',
      minChars: 'Type at least 2 characters',
    },
  } as const;

  function initAutocomplete() {
    const container = document.getElementById('aa-container') as HTMLElement | null;
    const fallback  = document.getElementById('aa-fallback-form') as HTMLElement | null;
    if (!container) return;

    // Destroy previous instance (Astro View Transitions re-mount)
    if (acInstance) {
      try { acInstance.destroy(); } catch {}
      acInstance = null;
    }

    const lang      = (container.dataset.lang ?? 'it') as Lang;
    const appId     = container.dataset.appId ?? '';
    const searchKey = container.dataset.searchKey ?? '';
    const searchHref = container.dataset.searchHref ?? (lang === 'en' ? '/en/search/' : '/cerca');

    // Silent fail: chiavi mancanti (staging senza env vars)
    if (!appId || !searchKey) return;

    const l = LABELS[lang] ?? LABELS.it;
    const searchClient = algoliasearch(appId, searchKey);

    // Mostra autocomplete, nascondi fallback
    container.style.display = '';
    if (fallback) fallback.style.display = 'none';

    acInstance = autocomplete({
      container,
      placeholder: l.placeholder,
      // Mai modale — sempre inline panel
      detachedMediaQuery: 'none',
      openOnFocus: false,
      // Debounce built-in: non aggiungerne uno manuale sopra
      stallThreshold: 300,

      getSources({ query }) {
        // Non inviare query < 2 caratteri
        if (!query || query.trim().length < 2) return [];

        const q = query.trim();

        return [
          // ── Articoli ──────────────────────────────────────────────────
          {
            sourceId: 'articoli',
            getItemUrl({ item }: { item: any }) {
              return item.url as string;
            },
            getItems() {
              return getAlgoliaResults({
                searchClient,
                queries: [
                  {
                    indexName: 'oel_articoli',
                    query: q,
                    params: {
                      filters: `lang:${lang}`,
                      hitsPerPage: 5,
                      attributesToSnippet: ['titolo:12', 'corpo:22'],
                      snippetEllipsisText: '…',
                    },
                  },
                ],
              });
            },
            templates: {
              header() {
                return `<span class="aa-SectionTitle">${l.articoli}</span>`;
              },
              item({ item, html, components }: any) {
                return html`
                  <a href="${item.url}" class="aa-ItemLink">
                    ${item.immagine_url
                      ? html`<img src="${item.immagine_url}" alt="" class="aa-ItemImg" loading="lazy" width="56" height="40" />`
                      : html`<div class="aa-ItemImgPlaceholder"></div>`
                    }
                    <div class="aa-ItemBody">
                      <div class="aa-ItemTitle">
                        ${components.Snippet({ hit: item, attribute: 'titolo' })}
                      </div>
                      ${item.autore_nome
                        ? html`<div class="aa-ItemMeta">${item.autore_nome}</div>`
                        : null
                      }
                      ${item._snippetResult?.corpo?.matchLevel !== 'none'
                        ? html`<div class="aa-ItemSnippet">
                            ${components.Snippet({ hit: item, attribute: 'corpo' })}
                          </div>`
                        : null
                      }
                    </div>
                  </a>`;
              },
              footer({ state }: any) {
                return `<a href="${searchHref}?q=${encodeURIComponent(state.query)}" class="aa-SeeAll">${l.seeAll} →</a>`;
              },
              noResults() {
                return `<p class="aa-NoResults">${l.noResults} "<strong>${q}</strong>"</p>`;
              },
            },
          },

          // ── Autori ────────────────────────────────────────────────────
          {
            sourceId: 'autori',
            getItemUrl({ item }: { item: any }) {
              return lang === 'en'
                ? `/en/authors/${item.slug}/`
                : `/autori/${item.slug}/`;
            },
            getItems() {
              return getAlgoliaResults({
                searchClient,
                queries: [{ indexName: 'oel_autori', query: q, params: { hitsPerPage: 3 } }],
              });
            },
            templates: {
              header() {
                return `<span class="aa-SectionTitle">${l.autori}</span>`;
              },
              item({ item, html }: any) {
                const url = lang === 'en'
                  ? `/en/authors/${item.slug}/`
                  : `/autori/${item.slug}/`;
                return html`
                  <a href="${url}" class="aa-ItemLink">
                    ${item.foto_url
                      ? html`<img src="${item.foto_url}" alt="" class="aa-ItemImg aa-ItemImg--round" loading="lazy" width="40" height="40" />`
                      : html`<div class="aa-ItemImgPlaceholder aa-ItemImgPlaceholder--round"></div>`
                    }
                    <div class="aa-ItemBody">
                      <div class="aa-ItemTitle">${item.nome_completo}</div>
                    </div>
                  </a>`;
              },
            },
          },

          // ── Numeri rivista ────────────────────────────────────────────
          {
            sourceId: 'numeri',
            getItemUrl({ item }: { item: any }) {
              return lang === 'en'
                ? `/en/archive/${String(item.id_numero).toLowerCase().replace(/[^a-z0-9-]/g, '-')}/`
                : item.url;
            },
            getItems() {
              return getAlgoliaResults({
                searchClient,
                queries: [{ indexName: 'oel_numeri', query: q, params: { hitsPerPage: 2 } }],
              });
            },
            templates: {
              header() {
                return `<span class="aa-SectionTitle">${l.numeri}</span>`;
              },
              item({ item, html }: any) {
                const url = lang === 'en'
                  ? `/en/archive/${String(item.id_numero).toLowerCase().replace(/[^a-z0-9-]/g, '-')}/`
                  : item.url;
                return html`
                  <a href="${url}" class="aa-ItemLink">
                    ${item.copertina_url
                      ? html`<img src="${item.copertina_url}" alt="" class="aa-ItemImg" loading="lazy" width="32" height="44" />`
                      : html`<div class="aa-ItemImgPlaceholder"></div>`
                    }
                    <div class="aa-ItemBody">
                      <div class="aa-ItemTitle">${item.display_title}</div>
                      ${item.anno_pubblicazione
                        ? html`<div class="aa-ItemMeta">${item.anno_pubblicazione}</div>`
                        : null
                      }
                    </div>
                  </a>`;
              },
            },
          },
        ];
      },

      // Navigazione tastiera → segue getItemUrl
      navigator: {
        navigate({ itemUrl }: { itemUrl: string }) {
          window.location.assign(itemUrl);
        },
      },

      // Invio senza selezionare un item → pagina risultati lang-aware
      onSubmit({ state }: any) {
        const q = state.query?.trim();
        if (q) {
          window.location.assign(
            `${searchHref}?q=${encodeURIComponent(q)}`
          );
        }
      },
    });
  }

  // Reinit a ogni navigazione Astro.
  // astro:after-swap garantisce che il DOM nuovo sia già nel documento prima del mount.
  // requestAnimationFrame assicura che il browser abbia completato il layout dopo lo swap.
  document.addEventListener('astro:after-swap', () => {
    requestAnimationFrame(initAutocomplete);
  });
  // Caricamento iniziale (nessun after-swap su prima navigazione)
  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(initAutocomplete);
  });
</script>

<style is:global>
  /* ── Contenitore e form ───────────────────────────────────────────────────── */
  #aa-container .aa-Autocomplete {
    width: 100%;
    position: relative;
  }

  #aa-container .aa-Form {
    display: flex;
    align-items: center;
    width: 100%;
    height: 40px;
    border: 1px solid var(--border-color, #e8e6e3);
    border-radius: 6px;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }

  #aa-container .aa-Form:focus-within {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(196, 30, 58, 0.12);
  }

  #aa-container .aa-InputWrapperPrefix {
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    color: var(--text-secondary, #5c5c5c);
    flex-shrink: 0;
  }

  #aa-container .aa-SubmitIcon,
  #aa-container .aa-LoadingIcon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  #aa-container .aa-InputWrapper {
    flex: 1;
    min-width: 0;
  }

  #aa-container .aa-Input {
    width: 100%;
    height: 38px;
    border: none;
    outline: none;
    background: transparent;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--text-color);
    padding: 0;
  }

  #aa-container .aa-Input::placeholder {
    color: var(--text-secondary, #5c5c5c);
  }

  #aa-container .aa-InputWrapperSuffix {
    display: flex;
    align-items: center;
    padding: 0 0.35rem;
    flex-shrink: 0;
  }

  #aa-container .aa-ClearButton {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: none;
    color: var(--text-secondary, #5c5c5c);
    cursor: pointer;
    border-radius: 4px;
    padding: 0;
    transition: color 0.15s;
  }

  #aa-container .aa-ClearButton:hover {
    color: var(--accent-color);
  }

  #aa-container .aa-ClearIcon {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* ── Panel (dropdown) ─────────────────────────────────────────────────────── */
  .aa-Panel {
    /* Portal su document.body: z-index sopra header (1100) e mega-menu (1090) */
    z-index: 1200 !important;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
    border: 1px solid var(--border-color, #e8e6e3);
    overflow: hidden;
    font-family: 'Raleway', system-ui, sans-serif;
  }

  .aa-PanelLayout {
    padding: 0.5rem 0;
    max-height: 480px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── Sezioni ──────────────────────────────────────────────────────────────── */
  .aa-Source {
    padding: 0;
  }

  .aa-SourceHeader {
    margin: 0;
    padding: 0.4rem 1rem 0.2rem;
  }

  .aa-SectionTitle {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #999;
  }

  .aa-List {
    list-style: none;
    margin: 0;
    padding: 0 0.35rem;
  }

  /* ── Item ─────────────────────────────────────────────────────────────────── */
  .aa-Item {
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.1s;
  }

  .aa-Item[aria-selected="true"],
  .aa-Item:hover {
    background: rgba(0,0,0,0.04);
  }

  .aa-ItemLink {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    text-decoration: none;
    color: inherit;
  }

  .aa-ItemImg {
    object-fit: cover;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .aa-ItemImg--round {
    border-radius: 50%;
  }

  .aa-ItemImgPlaceholder {
    width: 56px;
    height: 40px;
    background: var(--border-color, #e8e6e3);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .aa-ItemImgPlaceholder--round {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .aa-ItemBody {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .aa-ItemTitle {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aa-ItemMeta {
    font-size: 0.75rem;
    color: var(--text-secondary, #5c5c5c);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aa-ItemSnippet {
    font-size: 0.75rem;
    color: var(--text-secondary, #5c5c5c);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Highlight Algolia */
  .aa-ItemTitle mark,
  .aa-ItemSnippet mark {
    background: transparent;
    color: var(--accent-color);
    font-weight: 700;
  }

  /* ── Footer "Vedi tutti" + no-results ────────────────────────────────────── */
  .aa-SourceFooter {
    padding: 0.25rem 1rem 0.5rem;
  }

  .aa-SeeAll {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-color);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
    transition: color 0.15s;
  }

  .aa-SeeAll:hover {
    color: var(--accent-hover, #a0162e);
  }

  .aa-NoResults {
    font-size: 0.875rem;
    color: var(--text-secondary, #5c5c5c);
    padding: 0.5rem 1rem 0.75rem;
    margin: 0;
  }

  /* ── Separatore tra sezioni ───────────────────────────────────────────────── */
  .aa-Source + .aa-Source {
    border-top: 1px solid var(--border-color, #e8e6e3);
    margin-top: 0.25rem;
    padding-top: 0.25rem;
  }

  /* ── Mobile: autocomplete non mostrato sotto 768px (form overlay gestisce) ── */
  @media (max-width: 767px) {
    #aa-container {
      display: none !important;
    }
    #aa-fallback-form {
      display: none !important; /* anche il fallback è nascosto — usa mobile overlay */
    }
  }
</style>
