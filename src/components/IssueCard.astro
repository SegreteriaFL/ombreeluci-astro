---
interface Props {
  cover_url?: string;
  titolo_numero: string;
  numero: number;
  anno: number;
  periodo_label?: string;
  tipo_rivista: string;
  id_numero: string;
  lang?: string;
}

const { cover_url, titolo_numero, numero, anno, periodo_label, tipo_rivista, id_numero, lang } = Astro.props;

const isOEL = tipo_rivista !== 'insieme' && !id_numero.toLowerCase().startsWith('ins');

const numeroSlug = id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-');
const archiveBase = lang === 'en' ? '/en/archive' : '/archivio';
const linkUrl = `${archiveBase}/${numeroSlug}`;

// Titolo card: "N.172 – Paradigma Pompei"
// Rimuove prefissi ridondanti (es. "Numero 172 – " o "Ombre e Luci n. 172 – ")
// che compaiono quando titolo_numero viene dal fallback display_title.
const temaClean = titolo_numero
  ? titolo_numero
      .replace(/^ombre\s+e\s+luci\s+n\.?\s*\d+\s*[-–—]\s*/i, '')
      .replace(/^numero\s+\d+\s*[-–—]\s*/i, '')
      .trim()
  : '';
const cardTitle = temaClean ? `N.${numero} – ${temaClean}` : `N.${numero}`;

// Anno di vita della rivista: OEL anno 1 = 1983 → anno - 1982; INS anno 1 = 1974 → anno - 1973
const annoRivista = isOEL ? anno - 1982 : anno - 1973;

// Numero all'interno dell'anno (1–4) → cifra romana
// OEL: ~4 numeri/anno; INS: variabile, usiamo stesso calcolo
const ROMAN = ['I', 'II', 'III', 'IV'];
const numInAnno = ((numero - 1) % 4) + 1;
const numInAnnoRoman = ROMAN[numInAnno - 1] ?? String(numInAnno);

// Abbrevia "Ottobre – Dicembre" → "Ott-Dic"
const MESI_ABBR: Record<string, string> = {
  gennaio: 'Gen', febbraio: 'Feb', marzo: 'Mar', aprile: 'Apr',
  maggio: 'Mag', giugno: 'Giu', luglio: 'Lug', agosto: 'Ago',
  settembre: 'Set', ottobre: 'Ott', novembre: 'Nov', dicembre: 'Dic',
};
function abbreviaPeriodo(label: string): string {
  return label.replace(/[A-Za-zÀ-ÖØ-öø-ÿ]+/g, (w) => {
    const key = w.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    return MESI_ABBR[key] ?? w;
  }).replace(/\s*[–—-]\s*/g, '-').trim();
}

const periodoAbbr = periodo_label ? abbreviaPeriodo(periodo_label) : null;

// Riga meta finale: "Ott-Dic 2025 · Anno 42 · IV"
const metaParts: string[] = [];
if (periodoAbbr) metaParts.push(`${periodoAbbr} ${anno}`);
if (isOEL && annoRivista > 0) metaParts.push(`Anno ${annoRivista}`);
if (isOEL) metaParts.push(numInAnnoRoman);
const metaLine = metaParts.join(' · ');
---

<a href={linkUrl} class="issue-card">
  <div class="issue-card-image-wrapper">
    {cover_url ? (
      <img
        src={cover_url}
        alt={`Copertina ${cardTitle}`}
        class="issue-card-image"
        loading="lazy"
        data-copertina-fallback
      />
    ) : (
      <div class="issue-card-placeholder">
        <span class="issue-card-placeholder-text">{isOEL ? 'Ombre e Luci' : 'Insieme'}</span>
        <span class="issue-card-placeholder-number">n. {numero}</span>
      </div>
    )}
  </div>

  <div class="issue-card-content">
    <h3 class="issue-card-title">{cardTitle}</h3>
    {metaLine && (
      <p class="issue-card-meta">{metaLine}</p>
    )}
  </div>
</a>

<style>
  .issue-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }

  .issue-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .issue-card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f5;
  }

  .issue-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .issue-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 1rem;
  }

  .issue-card-placeholder-text {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .issue-card-placeholder-number {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .issue-card-content {
    padding: 0.75rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .issue-card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--text-color);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .issue-card-meta {
    font-size: 0.8125rem;
    color: var(--accent-color);
    margin: 0;
    margin-top: auto;
    padding-top: 0.375rem;
  }
</style>
