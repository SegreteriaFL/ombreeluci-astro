---
import { t, type Locale } from '../utils/i18n';
import ArticoliRullo from './ArticoliRullo.astro';
import type { ArticoloFull } from '../lib/directus';
import type { DiaristaConMeta } from '../data/diari.ts';

interface Props {
  lang: Locale;
  diaristiConMeta: DiaristaConMeta[];
  articoliDiari: ArticoloFull[];
  diariDescrizione: string | null;
}

const { lang, diaristiConMeta, articoliDiari, diariDescrizione } = Astro.props;

const defaultDesc = {
  it: 'I Diari di Ombre e Luci sono uno spazio narrativo dove autori fissi raccontano la propria vita con la disabilità — in famiglia, in comunità, nella fede — settimana dopo settimana.',
  en: 'The Diaries of Ombre e Luci are a narrative space where regular authors share their lives with disability — in the family, in the community, in faith — week after week.',
}[lang];

const hubTitle = {
  it: 'I Diari di Ombre e Luci',
  en: 'The Diaries of Ombre e Luci',
}[lang];

const diarByLabel = {
  it: 'di',
  en: 'by',
}[lang];

const feedTitle = {
  it: 'Tutti gli articoli dai Diari',
  en: 'All Diaries articles',
}[lang];

const feedDesc = {
  it: 'Gli ultimi contributi dagli autori dei Diari, dal più recente al più vecchio.',
  en: 'The latest contributions from the Diaries authors, most recent first.',
}[lang];

const diarioBasePath = lang === 'en' ? '/en/diaries' : '/it/diari';
const articleBasePath = lang === 'en' ? '/en' : '/it';
---

<main class="site-main diari-hub-bg">
  <div class="container diari-hub">
    <header class="diari-hub-header">
      <h1 class="diari-hub-title">
        <img src="/images/diari/icon-diari.svg" alt="" aria-hidden="true" class="diari-title-icon" width="32" height="32" />
        {hubTitle}
      </h1>
      <p class="diari-hub-desc">{diariDescrizione ?? defaultDesc}</p>
    </header>

    <section class="diari-grid" aria-label={hubTitle}>
      {diaristiConMeta.map((d) => (
        <a href={`${diarioBasePath}/${d.diarioSlug}`} class="diari-item">
          <div class="diari-item-photo">
            {d.fotoUrl ? (
              <img src={d.fotoUrl} alt={d.nome} width="80" height="80" loading="lazy" />
            ) : (
              <div class="diari-item-placeholder" aria-hidden="true" />
            )}
          </div>
          <div class="diari-item-text">
            <h3 class="diari-item-title">{d.titoloDiario}</h3>
            <p class="diari-item-author">{diarByLabel} {d.nome}</p>
          </div>
        </a>
      ))}
    </section>

    <div class="diari-feed">
      <ArticoliRullo
        title={feedTitle}
        description={feedDesc}
        articoli={articoliDiari}
        headingLevel={2}
        basePath={articleBasePath}
        locale={lang}
      />
    </div>
  </div>
</main>

<style>
  .diari-hub-bg {
    background-color: var(--diari-bg, #f0f7ff);
  }

  .diari-hub {
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .diari-hub-header {
    margin-bottom: 2.5rem;
  }

  .diari-hub-title {
    font-family: 'Ultra', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--text-color);
    margin-bottom: 0.75rem;
    line-height: 1.15;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .diari-title-icon {
    flex-shrink: 0;
    display: block;
  }

  .diari-hub-desc {
    max-width: 680px;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .diari-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 3rem;
  }

  .diari-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem 1.25rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    transition: opacity 0.18s;
  }

  .diari-item:hover {
    opacity: 0.8;
  }

  .diari-item:nth-child(even) {
    padding-left: 1.5rem;
    padding-right: 0;
    border-left: 1px solid rgba(0, 0, 0, 0.08);
  }

  .diari-item:nth-last-child(1),
  .diari-item:nth-last-child(2) {
    border-bottom: none;
  }

  .diari-item:last-child {
    border-bottom: none;
  }

  .diari-item-photo {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-light, #f5f5f5);
  }

  .diari-item-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .diari-item-placeholder {
    width: 100%;
    height: 100%;
    background: var(--border-color, #ddd);
  }

  .diari-item-title {
    font-family: 'Ultra', Georgia, serif;
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--text-color);
    margin-bottom: 0.2rem;
    line-height: 1.2;
  }

  .diari-item-author {
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .diari-feed {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
  }

  @media (max-width: 640px) {
    .diari-hub {
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
    }

    .diari-grid {
      grid-template-columns: 1fr;
      margin-bottom: 2rem;
    }

    .diari-item:nth-child(even) {
      padding-left: 0;
      border-left: none;
    }

    .diari-item:nth-last-child(2) {
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .diari-item:last-child {
      border-bottom: none;
    }

    .diari-feed {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }
  }
</style>
