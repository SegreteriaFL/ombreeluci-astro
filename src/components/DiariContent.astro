---
import { t, type Locale } from '../utils/i18n';
import ArticoliRullo from './ArticoliRullo.astro';
import type { ArticoloFull } from '../lib/directus';
import type { DiaristaConMeta } from '../data/diari.ts';

interface Props {
  lang: Locale;
  diaristiConMeta: DiaristaConMeta[];
  articoliDiari: ArticoloFull[];
  diariDescrizione: string | null;
}

const { lang, diaristiConMeta, articoliDiari, diariDescrizione } = Astro.props;

const defaultDesc = {
  it: 'Storie in prima persona, racconti di vita e di fragilità: i Diari sono lo spazio dove autori e lettori condividono esperienze, riflessioni e incontri. Una finestra aperta sulla vita quotidiana, sulle comunità e sul cammino di Fede e Luce.',
  en: 'First-person stories, accounts of life and fragility: the Diaries are the space where authors and readers share experiences, reflections and encounters. An open window onto everyday life, communities and the journey of Fede e Luce.',
}[lang];

const diariGridLabel = {
  it: 'I sette Diari',
  en: 'The seven Diaries',
}[lang];

const diarByLabel = {
  it: 'di',
  en: 'by',
}[lang];

const feedTitle = {
  it: 'Tutti gli articoli dai Diari',
  en: 'All Diaries articles',
}[lang];

const feedDesc = {
  it: 'Gli ultimi contributi dei sette autori dei Diari, dal più recente al più vecchio.',
  en: "The latest contributions from the seven Diaries authors, most recent first.",
}[lang];

const diarioBasePath = lang === 'en' ? '/en/diaries' : '/it/diari';
const articleBasePath = lang === 'en' ? '/en' : '/it';
---

<main class="site-main diari-section-bg">
  <div class="container diari-hub">
    <header class="diari-intro">
      <h1 class="diari-hub-title">{t(lang, 'diaries_title')}</h1>
      <p class="diari-hub-lead">
        {diariDescrizione ?? defaultDesc}
      </p>
    </header>

    <section class="diari-grid-section" aria-label={diariGridLabel}>
      <h2 class="visually-hidden">{diariGridLabel}</h2>
      <div class="diari-cards diari-cards--polaroid">
        {diaristiConMeta.map((d) => (
          <article class="diari-card diari-card--polaroid">
            <a href={`${diarioBasePath}/${d.diarioSlug}`} class="diari-card-link">
              <div class="diari-polaroid-frame">
                <div class="diari-polaroid-photo">
                  {d.fotoUrl ? (
                    <img src={d.fotoUrl} alt={d.nome} width="280" height="280" loading="lazy" />
                  ) : (
                    <div class="diari-card-photo-placeholder" aria-hidden="true" />
                  )}
                </div>
                <div class="diari-polaroid-caption">
                  <h3 class="diari-card-title">{d.titoloDiario}</h3>
                  <p class="diari-card-author">{diarByLabel} {d.nome}</p>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <div class="diari-feed-section">
      <ArticoliRullo
        title={feedTitle}
        description={feedDesc}
        articoli={articoliDiari}
        headingLevel={2}
        basePath={articleBasePath}
        locale={lang}
      />
    </div>
  </div>
</main>

<style>
  .diari-section-bg {
    background-color: var(--diari-bg);
  }

  .diari-hub {
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .diari-intro {
    margin-bottom: 3rem;
  }

  .diari-hub-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 0.75rem;
  }

  .diari-hub-lead {
    max-width: 720px;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-color);
  }

  .diari-grid-section {
    margin-bottom: 3rem;
  }

  .diari-cards--polaroid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .diari-card--polaroid {
    background: transparent;
  }

  .diari-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .diari-polaroid-frame {
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.9);
    padding: 0.75rem 0.75rem 1.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.2s ease;
  }
  .diari-card-link:hover .diari-polaroid-frame {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
  }

  .diari-polaroid-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-light);
  }
  .diari-polaroid-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .diari-card-photo-placeholder {
    width: 100%;
    height: 100%;
    background: var(--border-color);
  }

  .diari-polaroid-caption {
    padding-top: 1rem;
    text-align: left;
  }

  .diari-card-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .diari-card-author {
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .diari-feed-section {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  @media (max-width: 768px) {
    .diari-hub {
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
    }
    .diari-intro {
      margin-bottom: 2rem;
    }
    .diari-grid-section {
      margin-bottom: 2rem;
    }
    .diari-feed-section {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .diari-hub {
      padding-top: 1.25rem;
      padding-bottom: 2rem;
    }
    .diari-intro {
      margin-bottom: 1.5rem;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
