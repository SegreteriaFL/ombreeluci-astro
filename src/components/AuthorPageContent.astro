---
import ArticleCard from './ArticleCard.astro';
import { getMegaclusterForArticle, getLabels } from '../config/taxonomy.js';
import { getArticoloCopertinaSrc, getAutoreImageUrl } from '../lib/directus';
import type { ArticoloFull, Autore } from '../lib/directus';

interface Props {
  lang: 'it' | 'en';
  author: Autore;
  articles: ArticoloFull[];
  basePath: string;
}

const { lang, author, articles, basePath } = Astro.props;

const nomeAutore = author.nome_completo;
const authorFotoId = author.foto?.id ?? null;
const authorImagePath = authorFotoId
  ? getAutoreImageUrl(authorFotoId)
  : `/assets/authors/${author.slug}.jpg`;

const rawBio = (lang === 'en' && author.bio_en?.trim()) ? author.bio_en : author.bio_html;
const authorBioHtml = rawBio?.trim() || null;
const bioIsHtml = authorBioHtml ? /<[a-z][^>]*>/i.test(authorBioHtml) : false;

const articlesLabel =
  lang === 'en'
    ? articles.length === 1 ? 'article' : 'articles'
    : articles.length === 1 ? 'articolo' : 'articoli';
const articlesTitle = lang === 'en' ? 'Articles' : 'Articoli';
const articlesCountLabel =
  lang === 'en'
    ? `[${articles.length}] published articles`
    : `[${articles.length}] articoli pubblicati`;
const fallbackBio =
  lang === 'en'
    ? `Author of ${articles.length} ${articlesLabel} published on Ombre e Luci.`
    : `Autore di ${articles.length} ${articlesLabel} pubblicati su Ombre e Luci.`;
---

<main class="site-main">
  <div class="author-container">
    <div class="author-header">
      <div class="author-avatar-wrapper">
        <img
          src={authorImagePath}
          alt={nomeAutore}
          class="author-avatar-image"
          onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';"
          loading="lazy"
        />
        <div class="author-avatar-fallback" style="display: none;">
          {nomeAutore.charAt(0).toUpperCase()}
        </div>
      </div>
      <div class="author-info">
        <h1 class="author-name">{nomeAutore}</h1>
        <div class="author-bio">
          {authorBioHtml ? (
            <div
              class="author-bio-content"
              set:html={bioIsHtml
                ? authorBioHtml
                : `<p>${authorBioHtml.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`}
            />
          ) : (
            <>{fallbackBio}</>
          )}
        </div>
        <div class="author-stats">
          <div class="author-stats-item">
            <span class="author-stats-number">{articles.length}</span>
            <span>{articlesLabel}</span>
          </div>
        </div>
      </div>
    </div>

    <section class="articles-section">
      <div class="articles-header">
        <h2 class="articles-title">{articlesTitle}</h2>
        <p class="articles-count">{articlesCountLabel}</p>
      </div>

      <div class="articles-grid">
        {articles.map((a) => {
          const { categoria_menu, ruolo_editoriale } = getMegaclusterForArticle(a);
          const { formal } = getLabels([], a);
          const articleImage = getArticoloCopertinaSrc(a);
          return (
            <ArticleCard
              title={a.titolo}
              slug={a.slug}
              categoriaMenu={categoria_menu ?? undefined}
              issue={a.numero_rivista?.id_numero ?? null}
              forma={formal}
              author={a.autore?.nome_completo ?? nomeAutore}
              date={a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date()}
              image={articleImage}
              ruoloEditoriale={ruolo_editoriale ?? undefined}
              lang={lang}
              basePath={basePath}
            />
          );
        })}
      </div>
    </section>
  </div>
</main>

<style>
  .author-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .author-header {
    background: #fff;
    padding: 3rem 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    margin-bottom: 3rem;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .author-avatar-wrapper {
    position: relative;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }

  .author-avatar-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .author-avatar-fallback {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2.5rem;
    font-weight: 700;
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-family: 'Raleway', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .author-bio {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .author-bio-content i,
  .author-bio-content em { font-style: italic; }
  .author-bio-content b,
  .author-bio-content strong { font-weight: 700; }
  .author-bio-content a { color: var(--accent-color); text-decoration: none; }
  .author-bio-content a:hover { text-decoration: underline; }
  .author-bio-content p { margin: 0 0 0.75rem; }
  .author-bio-content p:last-child { margin-bottom: 0; }

  .author-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .author-stats-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-stats-number {
    font-weight: 600;
    color: #667eea;
  }

  .articles-section {
    margin-top: 3rem;
  }

  .articles-header {
    margin-bottom: 2rem;
  }

  .articles-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }

  .articles-count {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .author-container {
      padding: 1.5rem 1rem;
    }

    .author-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem 1.5rem;
    }

    .author-name {
      font-size: 2rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 480px) {
    .author-header {
      padding: 1.5rem 1rem;
      margin-bottom: 2rem;
      border-radius: 8px;
    }

    .author-name {
      font-size: 1.5rem;
    }

    .articles-section {
      margin-top: 2rem;
    }

    .articles-title {
      font-size: 1.5rem;
    }
  }
</style>
