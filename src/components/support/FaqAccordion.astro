---
import { EMAIL } from '../../config/support.ts';
import { getContenutiStatici, getCS } from '../../lib/directus';

interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;

// Contenuti statici da Directus
const cs = await getContenutiStatici('sostienici');

interface Item {
  q: string;
  a: string;
}

const items: Item[] = [
  {
    q: getCS(cs, 'support_faq_1_q', lang, lang === 'it' ? 'Ricevuta o detraibilità?' : 'Receipt or tax deduction?'),
    a: getCS(cs, 'support_faq_1_a', lang, lang === 'it' ? `Siamo un ETS. Se ti serve attestazione scrivici a ${EMAIL}.` : `We are an ETS registered in Italy. For documentation write to us at ${EMAIL}.`),
  },
  {
    q: getCS(cs, 'support_faq_2_q', lang, lang === 'it' ? 'Donazione ricorrente senza PayPal?' : 'Recurring donation without PayPal?'),
    a: getCS(cs, 'support_faq_2_a', lang, lang === 'it' ? 'Puoi impostare un bonifico ricorrente dalla tua banca (mensile o altro).' : 'You can set up a recurring bank transfer (monthly or otherwise).'),
  },
  {
    q: getCS(cs, 'support_faq_3_q', lang, lang === 'it' ? "Dall'estero?" : 'Donating from abroad?'),
    a: getCS(cs, 'support_faq_3_a', lang, lang === 'it' ? 'Contattaci e ti indichiamo il modo più semplice.' : "Contact us and we'll suggest the simplest way."),
  },
  {
    q: getCS(cs, 'support_faq_4_q', lang, lang === 'it' ? 'Come disdire?' : 'How to cancel?'),
    a: getCS(cs, 'support_faq_4_a', lang, lang === 'it' ? 'Da PayPal (nel tuo account) o annullando il bonifico ricorrente in banca.' : 'Via PayPal (in your account) or by cancelling the recurring bank transfer with your bank.'),
  },
];
---

<div class="faq-accordion" role="region" aria-label="Domande frequenti">
  {items.map((item, i) => (
    <div class="faq-item" data-faq-index={i}>
      <button type="button" class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${i}`} id={`faq-q-${i}`}>
        {item.q}
      </button>
      <div class="faq-answer" id={`faq-answer-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden>
        <p>{item.a}</p>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.faq-accordion .faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const id = btn.getAttribute('aria-controls');
      const panel = id ? document.getElementById(id) : null;
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) {
        panel.hidden = expanded;
      }
    });
  });
</script>

<style>
  .faq-accordion {
    border-top: 1px solid var(--border-color);
  }
  .faq-item {
    border-bottom: 1px solid var(--border-color);
  }
  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }
  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    color: var(--text-secondary);
    flex-shrink: 0;
    margin-left: 0.5rem;
  }
  .faq-question[aria-expanded="true"]::after {
    content: '−';
  }
  .faq-answer {
    padding: 0 0 1rem 0;
  }
  .faq-answer p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-color);
  }
  .faq-answer a {
    color: var(--accent-color);
  }
</style>
