---
import { t, type Locale } from '../utils/i18n';
import { getContenutiStatici, getCS } from '../lib/directus';
import AboutSidebar from './AboutSidebar.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Contenuti statici da Directus (con fallback inline)
const cs = await getContenutiStatici('chi-siamo');

// Fallback content (usato se Directus non disponibile)
const fallbackContent = {
  it: {
    manifesto: "Ombre e Luci è una rivista che da oltre quarant'anni accompagna le persone con disabilità, le loro famiglie e le comunità che li accolgono, offrendo riflessioni, testimonianze e strumenti per vivere insieme la diversità come una ricchezza.",
    magazine_lead: "Rivista trimestrale che mette al centro l'inclusione e la dignità di ogni persona, attraverso testimonianze, esperienze e riflessioni.",
    legacy_lead: 'I volti che hanno costruito Ombre e Luci dagli inizi fino a pochi anni fa.',
    authors_lead: 'Negli anni oltre 400 autori, testimoni e ospiti hanno contribuito a raccontare la fragilità sulle pagine di Ombre e Luci.',
  },
  en: {
    manifesto: 'Ombre e Luci is a magazine that for more than forty years has accompanied people with disabilities, their families, and the communities that welcome them, offering reflections, testimonies and tools for living together with diversity as a gift.',
    magazine_lead: 'A quarterly magazine centred on inclusion and the dignity of every person, through testimonies, experiences and reflections.',
    legacy_lead: 'The faces who built Ombre e Luci from the very beginning through recent years.',
    authors_lead: 'Over the years, more than 400 authors, witnesses and guests have contributed to telling the story of fragility in the pages of Ombre e Luci.',
  },
};

// Contenuti da Directus con fallback
const content = {
  manifesto: getCS(cs, 'about_manifesto', lang, fallbackContent[lang].manifesto),
  magazine_lead: getCS(cs, 'about_magazine_lead', lang, fallbackContent[lang].magazine_lead),
  legacy_lead: getCS(cs, 'about_legacy_lead', lang, fallbackContent[lang].legacy_lead),
  authors_lead: getCS(cs, 'about_authors_lead', lang, fallbackContent[lang].authors_lead),
  blocchi: [
    { titolo: getCS(cs, 'about_blocco_1_titolo', lang, lang === 'it' ? 'Testimonianze' : 'Testimonials'), descrizione: getCS(cs, 'about_blocco_1_desc', lang, lang === 'it' ? "Voci e storie di chi vive la disabilità e l'inclusione ogni giorno." : 'Voices and stories of those who live with disability and inclusion every day.'), href: lang === 'it' ? '/it/rubriche/testimonianze/' : '/en/sections/testimonies/' },
    { titolo: getCS(cs, 'about_blocco_2_titolo', lang, lang === 'it' ? 'Esperienze' : 'Experiences'), descrizione: getCS(cs, 'about_blocco_2_desc', lang, lang === 'it' ? 'Percorsi condivisi di comunità, associazioni e famiglie.' : 'Shared journeys of communities, associations and families.'), href: lang === 'it' ? '/it/categoria/progetti/' : '/en/category/projects/' },
    { titolo: getCS(cs, 'about_blocco_3_titolo', lang, lang === 'it' ? 'Riflessioni' : 'Reflections'), descrizione: getCS(cs, 'about_blocco_3_desc', lang, lang === 'it' ? "Approfondimenti su spiritualità, dignità e cultura dell'accoglienza." : 'In-depth pieces on spirituality, dignity and the culture of welcome.'), href: lang === 'it' ? '/it/categoria/spiritualita/' : '/en/category/spirituality/' },
    { titolo: getCS(cs, 'about_blocco_4_titolo', lang, lang === 'it' ? 'Cultura' : 'Culture'), descrizione: getCS(cs, 'about_blocco_4_desc', lang, lang === 'it' ? 'Recensioni, interviste e sguardi sul mondo che ci circonda.' : 'Reviews, interviews and perspectives on the world around us.'), href: lang === 'it' ? '/it/categoria/cultura/' : '/en/category/culture/' },
  ],
  timeline: [
    { anno: '1977', titolo: getCS(cs, 'about_timeline_1977_titolo', lang, lang === 'it' ? "Nasce 'Insieme'" : "Birth of 'Insieme'"), descrizione: getCS(cs, 'about_timeline_1977_desc', lang, lang === 'it' ? 'Il primo bollettino ciclostilato. Il desiderio di non restare soli.' : 'The first mimeographed bulletin. The wish not to remain alone.'), linkTesto: lang === 'it' ? 'Primo numero Insieme' : 'First Insieme issue', linkUrl: lang === 'it' ? '/it/archivio/ins--1' : '/en/archive/ins--1' },
    { anno: '1983', titolo: getCS(cs, 'about_timeline_1983_titolo', lang, 'Ombre e Luci'), descrizione: getCS(cs, 'about_timeline_1983_desc', lang, lang === 'it' ? 'Esce il numero 1. Formato professionale, temi di vita, fede e inclusione.' : 'Issue 1 published. Professional format, themes of life, faith and inclusion.'), linkTesto: lang === 'it' ? 'Numero 1 (PDF)' : 'Issue 1 (PDF)', linkUrl: 'https://archive.org/download/OmbreELuci_001/Ombre-e-Luci-n.1.pdf', linkPagina: lang === 'it' ? '/it/archivio/oel-1' : '/en/archive/oel-1' },
    { anno: '2010', titolo: getCS(cs, 'about_timeline_2010_titolo', lang, lang === 'it' ? 'Web' : 'Online'), descrizione: getCS(cs, 'about_timeline_2010_desc', lang, lang === 'it' ? 'La rivista approda online.' : 'The magazine goes online.') },
    { anno: '2018', titolo: getCS(cs, 'about_timeline_2018_titolo', lang, lang === 'it' ? 'Digitalizzazione' : 'Digitisation'), descrizione: getCS(cs, 'about_timeline_2018_desc', lang, lang === 'it' ? "Inizia il recupero dell'archivio storico, un 'regalo' per i 40 anni della rivista." : "The recovery of the historical archive begins — a 'gift' for the magazine's 40th anniversary."), linkTesto: lang === 'it' ? 'Leggi' : 'Read', linkUrl: '/it/digitalizzando-ombre-e-luci-come-un-album-di-famiglia' },
    { anno: '2023', titolo: getCS(cs, 'about_timeline_2023_titolo', lang, 'In English!'), descrizione: getCS(cs, 'about_timeline_2023_desc', lang, lang === 'it' ? 'Apertura internazionale con la versione inglese.' : 'International opening with the English edition.'), linkTesto: lang === 'it' ? 'Leggi' : 'Read', linkUrl: '/it/ombre-e-luci-in-inglese' },
    { anno: '2025', titolo: getCS(cs, 'about_timeline_2025_titolo', lang, lang === 'it' ? 'Progetto AiOeL' : 'AiOeL Project'), descrizione: getCS(cs, 'about_timeline_2025_desc', lang, lang === 'it' ? "L'intelligenza artificiale al servizio della memoria e delle voci dell'archivio." : 'Artificial intelligence in service of the memory and voices of the archive.'), linkTesto: lang === 'it' ? 'Leggi' : 'Read', linkUrl: '/it/intelligenza-artificiale-e-memoria-editoriale-il-mio-lavoro-con-ombre-e-luci' },
  ],
  comeLavoriamo: [
    getCS(cs, 'about_come_lavoriamo_1', lang, lang === 'it' ? 'Ascolto del territorio: ascoltiamo le comunità, le famiglie e i lettori per cogliere i temi che bruciano.' : 'Listening to the community: we listen to communities, families and readers to grasp the most pressing themes.'),
    getCS(cs, 'about_come_lavoriamo_2', lang, lang === 'it' ? 'Scelta del tema: ogni numero prende forma attorno a un tema guida, declinato in testimonianze, riflessioni e cultura.' : 'Choosing the theme: each issue takes shape around a guiding theme, explored through testimonies, reflections and culture.'),
    getCS(cs, 'about_come_lavoriamo_3', lang, lang === 'it' ? 'Cura del linguaggio: parole accessibili e rispettose, senza rinunciare alla profondità.' : 'Care with language: accessible and respectful words, without sacrificing depth.'),
    getCS(cs, 'about_come_lavoriamo_4', lang, lang === 'it' ? 'Apertura al dialogo: la rivista è un luogo di incontro tra voci diverse, in Italia e nel mondo.' : 'Openness to dialogue: the magazine is a meeting place for diverse voices, in Italy and around the world.'),
  ],
  readArticlesHref: lang === 'it' ? '/' : '/en/',
  supportHref: lang === 'it' ? '/it/sostienici' : '/en/support-us/',
  seeAllAuthorsHref: lang === 'it' ? '/it/autori' : '/en/authors/',
  legacyArchiveHref: lang === 'it' ? '/it/la-storica-redazione-ombre-luci/' : '/en/archive/',
  orari: [
    { giorno: getCS(cs, 'about_orari_1_giorno', lang, lang === 'it' ? 'Lun – Ven' : 'Mon – Fri'), ore: getCS(cs, 'about_orari_1_ore', lang, '10:00 – 13:00') },
    { giorno: getCS(cs, 'about_orari_2_giorno', lang, lang === 'it' ? 'Mercoledì' : 'Wednesday'), ore: getCS(cs, 'about_orari_2_ore', lang, '10:00 – 16:00') },
  ],
};

// Shared data — language-neutral (con override da Directus per ruolo e bio)
const redazioneChiave = [
  { nome: 'Giulia Galeotti', ruolo: getCS(cs, 'about_team_galeotti_ruolo', lang, lang === 'it' ? 'Direttore responsabile' : 'Editor-in-chief'), slug: 'giulia-galeotti', foto: 'giulia-galeotti.webp', bioBreve: getCS(cs, 'about_team_galeotti_bio', lang, lang === 'it' ? "Dirige la rivista con uno sguardo attento alla qualità editoriale e ai temi dell'inclusione e della spiritualità." : 'Leads the magazine with a keen eye for editorial quality and themes of inclusion and spirituality.') },
  { nome: 'Cristina Tersigni', ruolo: getCS(cs, 'about_team_tersigni_ruolo', lang, lang === 'it' ? 'Responsabile editoriale' : 'Editorial director'), slug: 'cristina-tersigni', foto: 'cristina-tersigni.webp', bioBreve: getCS(cs, 'about_team_tersigni_bio', lang, lang === 'it' ? 'Coordina la redazione e i progetti editoriali di Ombre e Luci, curando il dialogo tra contenuti e comunità.' : 'Coordinates the editorial team and projects of Ombre e Luci, nurturing the dialogue between content and community.') },
  { nome: 'Matteo Cinti', ruolo: getCS(cs, 'about_team_cinti_ruolo', lang, lang === 'it' ? 'Grafica e design' : 'Graphics and design'), slug: 'matteo-cinti', foto: 'matteo-cinti.png', bioBreve: getCS(cs, 'about_team_cinti_bio', lang, lang === 'it' ? "Cura l'identità visiva e la grafica della rivista, in carta e in digitale." : 'Responsible for the visual identity and design of the magazine, in print and digital.') },
  { nome: 'Franco Manuzio', ruolo: getCS(cs, 'about_team_manuzio_ruolo', lang, lang === 'it' ? 'Area digital' : 'Digital'), slug: 'franco-manuzio', foto: 'franco-manuzio.jpg', bioBreve: getCS(cs, 'about_team_manuzio_bio', lang, lang === 'it' ? "Responsabile dell'area digital, informatizzazione dell'archivio cartaceo e progetti di intelligenza artificiale." : 'Responsible for the digital area, digitisation of the print archive and artificial intelligence projects.') },
];

const storica = [
  { nome: 'Mariangela Bertolini', ruolo: { it: 'Fondatrice', en: 'Founder' }, slug: 'mariangela-bertolini', foto: 'mariangela-bertolini.png' },
  { nome: 'Nicole Schulthes', ruolo: { it: 'Caporedattore', en: 'Managing editor' }, slug: 'nicole-schulthes', foto: 'nicole-schulthes.jpg' },
  { nome: 'Sergio Sciascia', ruolo: { it: 'Direttore responsabile', en: 'Editor-in-chief' }, slug: 'sergio-sciascia', foto: 'sergio-sciascia.jpg' },
  { nome: 'Natalia Livi', ruolo: { it: 'Redazione', en: 'Editorial team' }, slug: 'natalia-livi', foto: 'natalia-livi.jpg' },
  { nome: 'Maria Teresa Mazzarotto', ruolo: { it: 'Redazione', en: 'Editorial team' }, slug: 'maria-teresa-mazzarotto', foto: 'maria-teresa-mazzarotto.jpg' },
];

const collaboratori = [
  { nome: 'Nicla Bettazzi', slug: 'nicla-bettazzi', foto: 'nicla-bettazzi.jpg' },
  { nome: 'Don Marco Bove', slug: 'marco-bove', foto: 'don-marco-bove.jpg' },
  { nome: 'Claudio Cinus', slug: 'claudio-cinus', foto: 'claudio-cinus.jpg' },
  { nome: 'Benedetta Mattei', slug: 'benedetta-mattei', foto: 'benedetta-mattei.png' },
  { nome: 'Rita Massi', slug: 'rita-massi', foto: 'rita-massi.png' },
  { nome: 'Giovanni Grossi', slug: 'giovanni-grossi', foto: 'giovanni-grossi.png' },
  { nome: 'Serena Sillitto', slug: 'serena-sillitto', foto: 'serena-sillitto.png' },
  { nome: 'Silvia Camisasca', slug: 'silvia-camisasca', foto: 'silvia-camisasca.jpg' },
  { nome: 'Silvia Gusmani', slug: 'silvia-gusmani', foto: 'silvia-gusmani.jpg' },
  { nome: 'Alessandro De Simone', slug: 'alessandro-de-simone', foto: 'alessandro-de-simone.jpg' },
  { nome: 'Laura Coccia', slug: 'laura-coccia', foto: 'laura-coccia.jpg' },
  { nome: 'Enrica Riera', slug: 'enrica-riera', foto: 'enrica-riera.png' },
];

function iniziali(nome: string): string {
  return (nome || '')
    .split(/\s+/)
    .map((p) => p.charAt(0))
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<main class="site-main chi-siamo-main" id="top">
  <div class="chi-siamo-layout container">
    <AboutSidebar active="" useAnchors={true} lang={lang} />

    <div class="chi-siamo-content">
      <!-- Hero -->
      <section class="chi-siamo-section chi-siamo-hero" id="hero">
        <div class="chi-siamo-section-inner">
          <h1 class="chi-siamo-title">{t(lang, 'about_title')}</h1>
          <p class="chi-siamo-manifesto">{content.manifesto}</p>
          <div class="chi-siamo-cta">
            <a href={content.readArticlesHref} class="button">{t(lang, 'about_cta_read')}</a>
            <a href={content.supportHref} class="button button-outline">{t(lang, 'about_cta_support')}</a>
          </div>
        </div>
      </section>

      <!-- La Rivista -->
      <section class="chi-siamo-section chi-siamo-section--cream" id="la-rivista">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_magazine_section')}</h2>
          <p class="chi-siamo-lead">{content.magazine_lead}</p>
          <div class="rivista-cards">
            {content.blocchi.map((b) => (
              <a href={b.href} class="rivista-card rivista-card-link">
                <h3 class="rivista-card-title">{b.titolo}</h3>
                <p class="rivista-card-desc">{b.descrizione}</p>
              </a>
            ))}
          </div>
          <div class="timeline-wrap">
            <h3 class="chi-siamo-h3">{t(lang, 'about_timeline_section')}</h3>
            <ol class="timeline">
              {content.timeline.map((tl) => (
                <li class="timeline-item">
                  <span class="timeline-anno">{tl.anno}</span>
                  <span class="timeline-titolo">{tl.titolo}</span>
                  <p class="timeline-desc">{tl.descrizione}</p>
                  {tl.linkTesto && tl.linkUrl && (
                    <p class="timeline-link">
                      <a href={tl.linkUrl} target={tl.linkUrl.startsWith('http') ? '_blank' : undefined} rel={tl.linkUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>{tl.linkTesto}</a>
                      {tl.linkPagina && <span> · </span>}
                      {tl.linkPagina && <a href={tl.linkPagina}>{t(lang, 'widget_go_to_issue')}</a>}
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- La Redazione -->
      <section class="chi-siamo-section" id="la-redazione">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_team_section')}</h2>
          <div class="redazione-grid redazione-grid--4">
            {redazioneChiave.map((r) => (
              <article class="redazione-card">
                <div class="redazione-card-photo redazione-card-photo--circle" aria-hidden="true">
                  <img src={`/images/redazione/${r.foto || r.slug + '.jpg'}`} alt="" width="200" height="200" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                  <span class="redazione-photo-fallback">{iniziali(r.nome)}</span>
                </div>
                <h3 class="redazione-card-nome"><a href={lang === 'en' ? `/en/authors/${r.slug}` : `/it/autori/${r.slug}`}>{r.nome}</a></h3>
                <p class="redazione-card-ruolo">{r.ruolo}</p>
                <p class="redazione-card-bio">{r.bioBreve}</p>
                <a href={lang === 'en' ? `/en/authors/${r.slug}` : `/it/autori/${r.slug}`} class="redazione-leggi-piu">{t(lang, 'about_read_more')}</a>
              </article>
            ))}
          </div>
          <div class="come-lavoriamo">
            <h3 class="chi-siamo-h3">{t(lang, 'about_how_we_work_section')}</h3>
            <ul class="come-lavoriamo-list">
              {content.comeLavoriamo.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- La Redazione Storica -->
      <section class="chi-siamo-section chi-siamo-section--cream" id="redazione-storica">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_legacy_section')}</h2>
          <p class="chi-siamo-lead">{content.legacy_lead} <a href={content.legacyArchiveHref}>{t(lang, 'about_legacy_archive_link')}</a> {t(lang, 'about_legacy_archive_arrow')}</p>
          <div class="storica-grid storica-grid--5">
            {storica.map((s) => (
              <article class="storica-card storica-card--solo-foto">
                <div class="storica-card-photo storica-card-photo--circle" aria-hidden="true">
                  <img src={`/images/redazione/${s.foto || s.slug + '.jpg'}`} alt="" width="200" height="200" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                  <span class="redazione-photo-fallback">{iniziali(s.nome)}</span>
                </div>
                <h3 class="storica-card-nome"><a href={lang === 'en' ? `/en/authors/${s.slug}` : `/it/autori/${s.slug}`}>{s.nome}</a></h3>
                <p class="storica-card-ruolo">{s.ruolo[lang]}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Collaboratori -->
      <section class="chi-siamo-section" id="collaboratori">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_collaborators_section')}</h2>
          <p class="chi-siamo-lead">{t(lang, 'about_collaborators_lead')}</p>
          <div class="collaboratori-grid collaboratori-grid--2x6">
            {collaboratori.map((c) => (
              <a href={lang === 'en' ? `/en/authors/${c.slug}` : `/it/autori/${c.slug}`} class="collaboratore-card collaboratore-card--solo-foto">
                <div class="collaboratore-photo collaboratore-photo--circle" aria-hidden="true">
                  <img src={`/images/redazione/${c.foto || c.slug + '.jpg'}`} alt="" width="80" height="80" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                  <span class="redazione-photo-fallback">{iniziali(c.nome)}</span>
                </div>
                <span class="collaboratore-nome">{c.nome}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Hanno scritto per noi -->
      <section class="chi-siamo-section chi-siamo-section--cream" id="hanno-scritto-per-noi">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_authors_section')}</h2>
          <p class="chi-siamo-lead hanno-scritto-testo">{content.authors_lead} <a href={content.seeAllAuthorsHref}>{t(lang, 'about_see_all_authors')}</a>.</p>
        </div>
      </section>

      <!-- Contatti -->
      <section class="chi-siamo-section" id="contatti">
        <div class="chi-siamo-section-inner">
          <h2 class="chi-siamo-h2">{t(lang, 'about_contacts_section')}</h2>
          <div class="contatti-grid">
            <div class="contatti-card">
              <h3 class="contatti-card-title">{t(lang, 'about_contact_email_label')}</h3>
              <p><a href="mailto:redazione@ombreeluci.it">redazione@ombreeluci.it</a></p>
            </div>
            <div class="contatti-card">
              <h3 class="contatti-card-title">{t(lang, 'about_contact_phone_label')}</h3>
              <p><a href="tel:+390612345678">+39 06 12345678</a></p>
            </div>
            <div class="contatti-card">
              <h3 class="contatti-card-title">{t(lang, 'about_contact_address_label')}</h3>
              <p>Via dei Cessati Spiriti 3, 00185 Roma</p>
            </div>
          </div>
          <div class="mappa-embed">
            <iframe
              title="Ombre e Luci — Via dei Cessati Spiriti 3, Roma"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2970.0!2d12.5113!3d41.8919!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x132f61a6a0b1f1b1%3A0x0!2sVia%20dei%20Cessati%20Spiriti%203%2C%2000185%20Roma!5e0!3m2!1sit!2sit!4v1715600000000"
              width="100%"
              height="340"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="contatti-orari">
            <h3 class="chi-siamo-h3">{t(lang, 'about_hours_section')}</h3>
            <table class="orari-table" aria-label={t(lang, 'about_hours_section')}>
              <tbody>
                {content.orari.map((row) => (
                  <tr><th scope="row">{row.giorno}</th><td>{row.ore}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>

<style>
  .chi-siamo-main {
    padding-top: 0;
  }

  .chi-siamo-layout {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .chi-siamo-content {
    flex: 1;
    min-width: 0;
    font-family: 'Raleway', system-ui, sans-serif;
    line-height: 1.8;
  }

  .chi-siamo-section {
    background: #ffffff;
    padding: 3rem 2rem;
    scroll-margin-top: var(--header-height, 80px);
  }

  .chi-siamo-section--cream {
    background: #FDFBF7;
    padding: 2rem;
  }

  .chi-siamo-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .chi-siamo-manifesto {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: var(--text-color);
  }

  .chi-siamo-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .chi-siamo-cta .button {
    text-decoration: none;
    font-weight: 600;
  }

  .button-outline {
    background: transparent !important;
    color: var(--accent-color) !important;
    border: 2px solid var(--accent-color);
  }

  .button-outline:hover {
    background: rgba(196, 30, 58, 0.08) !important;
    border-color: var(--accent-hover);
  }

  .chi-siamo-h2 {
