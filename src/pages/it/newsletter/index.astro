---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsletterContent from '../../../components/NewsletterContent.astro';
import { getAllArticoliBuild } from '../../../lib/articoli-build';

const tuttiArticoli = await getAllArticoliBuild();
const newsletters = tuttiArticoli
  .filter(a => a.slug.toLowerCase().includes('newsletter') && a.lang !== 'en')
  .sort((a, b) => {
    const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
    const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
    return tB - tA;
  });
---

<BaseLayout
  title="Newsletter — Ombre e Luci"
  description="Iscriviti alla newsletter di Ombre e Luci: storie, riflessioni e novità sulla disabilità e sulla fragilità umana direttamente nella tua casella di posta."
  lang="it"
  alternateArticleUrl="/en/newsletter/"
>
  <NewsletterContent lang="it" newsletters={newsletters} />
</BaseLayout>
