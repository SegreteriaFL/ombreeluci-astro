---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoriaPageContent from '../../../components/CategoriaPageContent.astro';
import { getAllCategorySlugs, getMegaclusterForArticle, getRoleWeight, getCategoriaUrlSlug, getCategoriaLabel } from '../../../config/taxonomy.js';
import { getContenutiStatici, getCS, getArticoliInEvidenza } from '../../../lib/directus';
import { getAllArticoliBuild } from '../../../lib/articoli-build';

export async function getStaticPaths() {
  const allArticles = (await getAllArticoliBuild()).filter((a) => a.lang !== 'en');
  const categorySlugs = getAllCategorySlugs();
  // Fetch contenuti_statici una volta sola per tutte le categorie
  const csCategorie = await getContenutiStatici('categorie');
  return Promise.all(categorySlugs.map(async (categoria) => {
    const displayLabel = getCategoriaLabel(categoria, 'it') ?? categoria;
    const articoli = allArticles.filter((a) => a.categoria_menu === categoria || a.categoria_menu_2 === categoria).sort((a, b) => {
      const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
      const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
      if (tA !== tB) return tB - tA;
      const weightA = getRoleWeight(getMegaclusterForArticle(a).ruolo_editoriale);
      const weightB = getRoleWeight(getMegaclusterForArticle(b).ruolo_editoriale);
      return weightB - weightA;
    });
    const descrizione = getCS(csCategorie, `categoria_${categoria}_descrizione`, 'it', '') || null;
    const evidenza = await getArticoliInEvidenza(categoria);
    return {
      params: { categoria },
      props: {
        articoli,
        categoryLabel: displayLabel,
        descrizione,
        evidenza,
      },
    };
  }));
}

const { articoli, categoryLabel, descrizione, evidenza } = Astro.props;
const { categoria } = Astro.params;
const alternateArticleUrl = `/en/category/${getCategoriaUrlSlug(categoria, 'en')}/`;
---

<BaseLayout
  title={categoryLabel}
  description={descrizione ?? `Articoli nella categoria ${categoryLabel} su Ombre e Luci`}
  alternateArticleUrl={alternateArticleUrl}
  alternates={[
    { lang: 'it', url: `https://ombreeluci.it/it/categoria/${categoria}/` },
    { lang: 'en', url: `https://ombreeluci.it/en/category/${getCategoriaUrlSlug(categoria, 'en')}/` },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ombreeluci.it" },
        { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": Astro.url.href }
      ]
    })} />
  </Fragment>
  <main class="site-main">
    <CategoriaPageContent
      articoli={articoli}
      categoryLabel={categoryLabel}
      descrizione={descrizione}
      categoriaSlug={categoria}
      evidenza={evidenza}
      lang="it"
      basePath="/it"
    />
  </main>
</BaseLayout>
