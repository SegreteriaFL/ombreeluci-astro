---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RubricaPageContent from '../../../components/RubricaPageContent.astro';
import rubricheData from '../../../data/rubriche.json';
import { getAllArticoliBuild } from '../../../lib/articoli-build';
import { getLabels } from '../../../config/taxonomy.js';

export async function getStaticPaths() {
  const allArticles = (await getAllArticoliBuild()).filter((a) => a.lang !== 'en');
  return rubricheData
    .filter((r) => r.filtro === 'forma')
    .map((rubrica) => {
      const articoli = allArticles
        .filter((a) => getLabels([], a).formal === rubrica.valore)
        .sort((a, b) => {
          const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
          const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
          return tB - tA;
        });
      return {
        params: { rubrica: rubrica.slug },
        props: { rubrica, articoli },
      };
    });
}

const { rubrica, articoli } = Astro.props;
const alternateEnUrl = `/en/sections/${rubrica.en_slug}/`;
---

<BaseLayout
  title={rubrica.it}
  description={`${rubrica.it}: rubrica di Ombre e Luci`}
  lang="it"
  alternateArticleUrl={alternateEnUrl}
  alternates={[
    { lang: 'it', url: new URL(`/it/rubriche/${rubrica.slug}/`, Astro.site).href },
    { lang: 'en', url: new URL(`/en/sections/${rubrica.en_slug}/`, Astro.site).href },
  ]}
>
  <main class="site-main">
    <RubricaPageContent lang="it" rubrica={rubrica} articoli={articoli} />
  </main>
</BaseLayout>
