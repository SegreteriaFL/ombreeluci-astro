---
export const prerender = false;

import { getArticoloBySlug, getArticoliBySlugList, getArticoloCopertinaSrc, getAutoreImageUrl, getFallbackRelatedArticles, COPERTINA_IMG_ONERROR, directusCredsFromAstroLocals, type ArticoloListItem } from '../../lib/directus';
import { getPlaceholder } from '../../utils/placeholder';
import ArticlePageLayout from '../../layouts/ArticlePageLayout.astro';
import EditorialFeedback from '../../components/EditorialFeedback.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getLabels, getMegaclusterForArticle, getThemeLabel, getCategorySlugForArticle, getCategoriaUrlSlug, getFormaToRubricaSlug } from '../../config/taxonomy.js';
import { getLangFromUrl, t, localizeFormalType } from '../../utils/i18n';
import autoriStats from '../../data/autori_stats.json';
import LeggiAnche from '../../components/LeggiAnche.astro';
import Commenti from '../../components/Commenti.astro';
import CTAArticolo from '../../components/CTAArticolo.astro';

const totalAutori = Array.isArray(autoriStats) ? autoriStats.length : 0;

// ── SSR: fetch articolo on-demand ──────────────────────────────────────────────

const creds = directusCredsFromAstroLocals(Astro.locals);
const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug.replace(/\/$/, '');

let articolo;
try {
  articolo = await getArticoloBySlug(slug, creds);
} catch (e) {
  console.error('[blog/[...slug].astro] fetch error:', e);
  articolo = null;
}

if (!articolo) {
  return new Response('Not found', { status: 404 });
}

// Fase 2 i18n: gli articoli EN hanno ora URL canonico /en/[slug-senza-en]/.
// Il middleware li reindirizza prima di arrivare qui; questo guard è un fallback sicuro.
if (articolo.lang === 'en') {
  const enUrlSlug = slug.endsWith('-en') ? slug.slice(0, -3) : slug;
  return Astro.redirect(`/en/${enUrlSlug}/`, 301);
}

// Cache-Control: edge cache 1h (evita stale 404 in caso di downtime),
// browser/CDN può servire stale fino a 24h durante revalidazione in background.
Astro.response.headers.set('Cache-Control', 's-maxage=3600, stale-while-revalidate=86400');

// Fase 1 i18n: locale determinato da articolo.lang (fonte autoritativa), non dall'URL.
// L'URL /blog/slug-en non matcha i pattern EN di getLangFromUrl, portando a shell IT su articoli EN.
const locale = articolo.lang === 'en' ? 'en' as const : 'it' as const;
const issueLabel = locale === 'en' ? 'Issue' : 'Numero';
const badgeIssueAriaLabel = locale === 'en' ? 'Category and issue' : 'Categoria e numero';
const shareLabelFacebook = locale === 'en' ? 'Share on Facebook' : 'Condividi su Facebook';
const shareLabelX = locale === 'en' ? 'Share on X (Twitter)' : 'Condividi su X (Twitter)';
const shareLabelWhatsapp = locale === 'en' ? 'Share on WhatsApp' : 'Condividi su WhatsApp';
const shareLabelLinkedin = locale === 'en' ? 'Share on LinkedIn' : 'Condividi su LinkedIn';
const copyLinkLabel = locale === 'en' ? 'Copy link' : 'Copia link';
const copiedLinkLabel = locale === 'en' ? 'Link copied!' : 'Link copiato!';

// ── Fetch correlati.json a runtime (mai importato staticamente) ───────────────

let correlatiMap: Record<string, string[]> = {};
try {
  const correlatiRes = await fetch(`${Astro.url.origin}/correlati.json`);
  if (correlatiRes.ok) correlatiMap = await correlatiRes.json();
} catch (e) {
  console.warn('[blog/[...slug].astro] correlati.json fetch failed:', e);
}

const correlatiSlugsRaw: string[] = correlatiMap[articolo.slug] ?? [];

// Fetch solo gli articoli correlati (max 10) per slugToArticolo, LeggiAnche e correlati in calce.
// Fallback: se la mappa correlati non contiene lo slug, usa articoli recenti stessa lingua/categoria.
let correlatiArticoli: ArticoloListItem[] = await getArticoliBySlugList(correlatiSlugsRaw.slice(0, 10), creds).catch(() => []);
if (correlatiArticoli.length === 0) {
  const preferred = await getFallbackRelatedArticles(
    {
      excludeSlug: articolo.slug,
      lang: articolo.lang === 'en' ? 'en' : 'it',
      categoriaMenu: articolo.categoria_menu ?? null,
      limit: 4,
    },
    creds
  ).catch(() => []);

  correlatiArticoli = preferred;
  if (correlatiArticoli.length === 0) {
    correlatiArticoli = await getFallbackRelatedArticles(
      {
        excludeSlug: articolo.slug,
        lang: articolo.lang === 'en' ? 'en' : 'it',
        limit: 4,
      },
      creds
    ).catch(() => []);
  }
}

const correlatiSlugsEffective: string[] =
  correlatiSlugsRaw.length > 0 ? correlatiSlugsRaw : correlatiArticoli.map((a) => a.slug);

// ── Helper functions ───────────────────────────────────────────────────────────

function formatDateItalian(date: Date, lang: 'it' | 'en' = 'it'): string {
  return new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'it-IT', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

function generateAuthorSlug(name: string): string {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function generateIssueSlug(issueNumber: string): string {
  return issueNumber.toLowerCase().replace(/[^a-z0-9-]/g, '-');
}

function calculateReadingTimeFromHtml(html: string | null): number {
  if (!html) return 3;
  const textOnly = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const wordCount = textOnly.split(/\s+/).filter((w: string) => w.length > 0).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}

// ── Dati articolo ──────────────────────────────────────────────────────────────

const articleTitle = articolo.titolo;
const articleDate = articolo.data_pubblicazione ? new Date(articolo.data_pubblicazione) : new Date();
const autoreCompleto = articolo.autore as any;
const autoreName: string = autoreCompleto?.nome_completo ?? t(locale, 'author_unknown');
const authorSlug = generateAuthorSlug(autoreName);

const authorBioHtml: string | null = autoreCompleto?.bio_html?.trim() || null;
const isJeanVanier: boolean = (autoreCompleto?.slug === 'jean-vanier') || autoreName.toLowerCase().includes('jean vanier');
const authorFotoId: string | null = autoreCompleto?.foto?.id ?? null;
const authorImagePath = authorFotoId ? getAutoreImageUrl(authorFotoId) : `/assets/authors/${authorSlug}.jpg`;
const authorBio: string | null = authorBioHtml;

const _bioStripped = authorBioHtml ? authorBioHtml.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim() : null;
const authorBioTruncated: string | null = _bioStripped && _bioStripped.length > 200
  ? _bioStripped.substring(0, 200).replace(/\s\S*$/, '') + '…'
  : null;

const readingTime = calculateReadingTimeFromHtml(articolo.corpo);
const slugToArticolo = Object.fromEntries(correlatiArticoli.map((a) => [a.slug, a]));

// ── Leggi anche — split corpo dopo il 3° </p> ─────────────────────────────────
function splitCorpoAfterNthParagraph(html: string, n: number): [string, string] {
  let count = 0;
  let idx = 0;
  while (count < n && idx < html.length) {
    const next = html.indexOf('</p>', idx);
    if (next === -1) break;
    idx = next + 4;
    count++;
  }
  if (count < n) return [html, ''];
  return [html.slice(0, idx), html.slice(idx)];
}

// ── Embed processing (YouTube + Instagram) ────────────────────────────────────

function extractYouTubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/))([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

function extractInstagramId(url: string): string | null {
  const m = url.match(/instagram\.com\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/);
  return m ? m[1] : null;
}

function processEmbeds(html: string): { html: string; hasInstagram: boolean } {
  let out = html;
  let hasInstagram = false;

  // 1. YouTube: URL grezzo in <p> → iframe embed responsive
  out = out.replace(
    /<p>\s*(https?:\/\/(?:youtu\.be\/|(?:www\.)?youtube\.com\/watch[^\s<"]*)[^\s<"]*)\s*<\/p>/gi,
    (_, url) => {
      const id = extractYouTubeId(url);
      if (!id) return `<p>${url}</p>`;
      return `<div class="video-embed"><iframe src="https://www.youtube.com/embed/${id}" title="Video YouTube" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>`;
    }
  );

  // 2. Instagram: blockquote con data-instgrm-permalink → iframe embed + script flag
  if (/<blockquote[^>]+instagram/i.test(out)) {
    hasInstagram = true;
    // normalizza: assicura che il blockquote abbia la classe instagram-media (alcuni potrebbero mancarla)
    out = out.replace(
      /(<blockquote\b(?![^>]*class)[^>]*)(data-instgrm-permalink)/gi,
      '$1class="instagram-media" $2'
    );
  }

  return { html: out, hasInstagram };
}

const rawCorpo = articolo.corpo ?? '';
const { html: processedCorpo, hasInstagram } = processEmbeds(rawCorpo);

const leggiAncheSlug = articolo.lang !== 'en'
  ? correlatiSlugsEffective.find((s) => {
      // Evita loop A→B→A: salta B se il primo correlato di B è A
      if (correlatiSlugsRaw.length === 0) return true;
      const bCorrelati = correlatiMap[s] ?? [];
      return bCorrelati[0] !== articolo.slug;
    }) ?? null
  : null;
const leggiAncheArticolo = leggiAncheSlug ? slugToArticolo[leggiAncheSlug] ?? null : null;
const [corpoPart1, corpoPart2] = leggiAncheArticolo && processedCorpo
  ? splitCorpoAfterNthParagraph(processedCorpo, 3)
  : [processedCorpo, ''];

// ── Issue (numero rivista) ─────────────────────────────────────────────────────

const issueNumber = articolo.numero_rivista?.id_numero ?? null;
const issueSlug = issueNumber ? generateIssueSlug(issueNumber) : null;
const issueLink = issueSlug ? `/it/archivio/${issueSlug}` : null;

// ── Immagine copertina ─────────────────────────────────────────────────────────

const articleImageRaw = getArticoloCopertinaSrc(articolo);
const articleImage = articolo.immagine_copertina?.id
  ? articleImageRaw
  : getPlaceholder(articolo.slug ?? '').src;

// ── Sottotitolo e SEO ──────────────────────────────────────────────────────────

const explicitSubtitle = articolo.sottotitolo?.trim() || articolo.seo_description?.trim() || null;
const heroCaption: string | null = articolo.didascalia_copertina?.trim() || null;

const metaDescription = (explicitSubtitle || articolo.seo_description)
  ? (explicitSubtitle || articolo.seo_description)!.substring(0, 160).replace(/\s+/g, ' ').trim()
  : `${articleTitle} - ${t(locale, 'meta_article_default_suffix')}`;

// ── Categoria, etichette, ruolo editoriale (taxonomy.js via megacluster) ───────

const categoryDisplay = getThemeLabel(articolo);
const categorySlug = getCategorySlugForArticle(articolo);
const categoryLink = categorySlug
  ? locale === 'en'
    ? `/en/category/${getCategoriaUrlSlug(categorySlug, 'en')}/`
    : `/it/categoria/${categorySlug}/`
  : null;
const currentLabels = getLabels([], articolo);
const formaDisplay =
  currentLabels.formal && currentLabels.formal !== 'Articolo'
    ? localizeFormalType(currentLabels.formal, locale)
    : null;
const rubricaSlug = getFormaToRubricaSlug(currentLabels.formal);
const formaLink = rubricaSlug ? `/it/rubriche/${rubricaSlug}/` : null;
const hasIssue = issueNumber != null && String(issueNumber).trim() !== '';
const showPubblicatoOnline = !hasIssue;

const { ruolo_editoriale } = getMegaclusterForArticle(articolo);
let roleLabel: string | null = null;
let roleClassName = '';
if (ruolo_editoriale === 'portante') {
  roleLabel = t(locale, 'badge_role_portante');
  roleClassName = ' article-badge-role--portante';
} else if (ruolo_editoriale === 'strutturale') {
  roleLabel = t(locale, 'badge_role_strutturale');
  roleClassName = ' article-badge-role--strutturale';
} else if (ruolo_editoriale === 'laterale') {
  roleLabel = t(locale, 'badge_role_laterale');
  roleClassName = ' article-badge-role--laterale';
} else if (ruolo_editoriale === 'trasversale') {
  roleLabel = t(locale, 'badge_role_trasversale');
  roleClassName = ' article-badge-role--trasversale';
}

// ── PDF e copertina numero rivista ─────────────────────────────────────────────

const pdfUrl: string | null = articolo.numero_rivista?.pdf_archive_url ?? null;
const copeertinaUrl: string | null = null;
const isTranslation = articolo.lang === 'en';

// ── Language switcher ──────────────────────────────────────────────────────────

const isCurrentEn = articolo.lang === 'en';
const currentWpIdClean = String(articolo.wp_id ?? '');
const currentSlug = articolo.slug;

// articolo_traduzione è già nel payload di getArticoloBySlug — nessuna query extra
const alternateItem = articolo.articolo_traduzione ?? null;
// Fase 2 i18n: se il counterpart è EN, punta al nuovo URL canonico /en/[slug-senza-en].
const alternateArticleUrl = alternateItem
  ? alternateItem.lang === 'en'
    ? `${Astro.url.origin}/en/${alternateItem.slug.endsWith('-en') ? alternateItem.slug.slice(0, -3) : alternateItem.slug}`
    : `${Astro.url.origin}/it/${alternateItem.slug}`
  : null;

// ── wpIdToSlugMap — solo dai correlati (per link enrichment client-side) ────────

const wpIdToSlugMap: Record<number, string> = {};
for (const a of correlatiArticoli) {
  if (a.wp_id && a.slug) wpIdToSlugMap[a.wp_id] = a.slug;
}

// ── inContentRelatedMap — solo dai correlati ───────────────────────────────────

const inContentRelatedMap: Record<string, {
  title: string; image: string | null; excerpt: string | null;
  href: string; category?: string | null; lang?: string; isItalian?: boolean;
}> = {};

for (const a of correlatiArticoli) {
  const imgUrl = getArticoloCopertinaSrc(a);
  const lang = a.lang;
  const isItalian = lang !== 'en';
  const category = getCategorySlugForArticle(a) ?? null;
  inContentRelatedMap[a.slug] = {
    title: a.titolo,
    image: imgUrl,
    excerpt: a.sottotitolo?.trim() || null,
    href: isItalian ? `/it/${a.slug}` : `/en/${a.slug.endsWith('-en') ? a.slug.slice(0, -3) : a.slug}`,
    category,
    lang,
    isItalian,
  };
}

// ── Articoli correlati in calce (UMAP semantici) ──────────────────────────────

const correlatiSlugs: string[] = correlatiSlugsEffective;

const relatedArticles = (() => {
  // Correlati UMAP: salta il primo (già usato nel box "Leggi anche"), max 3
  const umap = correlatiSlugs
    .filter((s) => s !== leggiAncheSlug)
    .map((s) => slugToArticolo[s])
    .filter((a): a is ArticoloListItem => !!a && a.id !== articolo.id && (isCurrentEn ? a.lang === 'en' : a.lang !== 'en'))
    .slice(0, 3);

  return umap.map((a) => {
    const labels = getLabels([], a);
    const { ruolo_editoriale: relRuolo } = getMegaclusterForArticle(a);
    return {
      title: a.titolo,
      author: a.autore?.nome_completo ?? t(locale, 'author_unknown'),
      date: a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date(),
      issue: a.numero_rivista?.id_numero ?? null,
      slug: a.slug,
      image: getArticoloCopertinaSrc(a),
      categoriaMenu: getThemeLabel(a) ?? null,
      forma: labels.formal,
      ruoloEditoriale: relRuolo,
    };
  });
})();
---



<ArticlePageLayout
  title={articleTitle}
  description={metaDescription}
  ogImage={articleImage}
  ogType="article"
  lang={articolo.lang === 'en' ? 'en' : 'it'}
  noindex={true}
  alternateArticleUrl={alternateArticleUrl}
  alternates={[
    { lang: articolo.lang === 'en' ? 'en' : 'it', url: Astro.url.href },
    ...(alternateArticleUrl ? [{ lang: articolo.lang === 'en' ? 'it' : 'en', url: alternateArticleUrl }] : []),
  ]}
>
  <Fragment slot="head">
    <meta name="pagefind:meta" content={`author:${autoreName}`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": articleTitle,
      "description": metaDescription ?? undefined,
      "image": articleImage?.startsWith('http') ? articleImage : `https://ombreeluci.it${articleImage}`,
      "datePublished": articleDate.toISOString(),
      "dateModified": articleDate.toISOString(),
      "inLanguage": articolo.lang === 'en' ? 'en-US' : 'it-IT',
      "author": {
        "@type": "Person",
        "name": autoreName,
        "url": `https://ombreeluci.it/it/autori/${authorSlug}`
      },
      "publisher": {
        "@type": "Organization",
        "name": "Ombre e Luci",
        "url": "https://ombreeluci.it",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ombreeluci.it/logo.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href
      },
      ...(articolo.numero_rivista?.id_numero ? {
        "isPartOf": {
          "@type": "PublicationIssue",
          "@id": `https://ombreeluci.it/archivio/${articolo.numero_rivista.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`
        }
      } : {})
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": (() => {
        const site = 'https://ombreeluci.it';
        const archiveHref = locale === 'en' ? `${site}/en` : `${site}/archivio`;
        const items: Record<string, unknown>[] = [
          {
            "@type": "ListItem",
            "position": 1,
            "name": t(locale, 'nav_archive'),
            "item": archiveHref,
          },
        ];
        if (categoryDisplay && categoryLink) {
          items.push({
            "@type": "ListItem",
            "position": 2,
            "name": categoryDisplay,
            "item": `${site}${categoryLink}`,
          });
        }
        items.push({
          "@type": "ListItem",
          "position": items.length + 1,
          "name": articleTitle,
        });
        return items;
      })(),
    })} />
  </Fragment>
    <main class="site-main">
    {/* Reading Progress Bar */}
    <div class="reading-progress" id="reading-progress"></div>
    
    <div class="article-container">
      {/* Breadcrumbs */}
      <nav class="breadcrumbs">
        <a href={locale === 'en' ? '/en/' : '/it/archivio'}>{t(locale, 'nav_archive')}</a>
        {issueNumber && (
          <>
            {' > '}
            <a href={issueLink}>{issueLabel} {issueNumber}</a>
          </>
        )}
      </nav>

      {/* Header Centrato - max-width: 900px */}
      <header class="article-header-wrapper">
        {/* Badge: [Numero] • [Forma] / [categoria_menu] – label cliccabili verso categorie */}
        {!showPubblicatoOnline ? (
          <nav class="article-category-badge" aria-label={badgeIssueAriaLabel}>
            {issueLink && <a href={issueLink} class="article-badge-link">{issueLabel} {issueNumber}</a>}
            {issueLink && (formaDisplay || categoryLink) && <span class="article-badge-sep"> • </span>}
            {formaDisplay && (formaLink
              ? <a href={formaLink} class="article-badge-link">{formaDisplay}</a>
              : <span class="article-badge-text">{formaDisplay}</span>
            )}
            {formaDisplay && categoryDisplay && <span class="article-badge-sep"> / </span>}
            {categoryLink ? (
              <a href={categoryLink} class="article-badge-link">{categoryDisplay}</a>
            ) : (
              <span class="article-badge-text">{categoryDisplay}</span>
            )}
          </nav>
        ) : (
          <div class="article-category-badge article-category-badge--online">
            {categoryLink ? (
              <a href={categoryLink} class="article-badge-link">{categoryDisplay}</a>
            ) : (
              t(locale, 'published_online')
            )}
          </div>
        )}

        <h1 class="article-title">{articleTitle}</h1>
        
        {/* Sottotitolo: usa il sottotitolo “vero” dal frontmatter, se presente */}
        {explicitSubtitle && (
          <div class="article-subtitle">
            {explicitSubtitle}
          </div>
        )}
        
        {/* Metadati con foto autore */}
        <div class="article-meta">
          <div class="article-meta-item">
            <img 
              src={authorImagePath}
              alt={autoreName}
              class="article-meta-author-image"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              loading="lazy"
            />
            <div class="article-meta-author-placeholder" style="display: none;">
              {autoreName.charAt(0).toUpperCase()}
            </div>
            <a href={`/it/autori/${authorSlug}`} class="author-link">{autoreName}</a>
          </div>
          <div class="article-meta-item">
            {formatDateItalian(articleDate, locale)}
          </div>
          <div class="article-meta-item">
            {readingTime} {t(locale, 'min_read')}
          </div>
          {roleLabel && (
            <div class="article-meta-item">
              <span class={`article-badge-role${roleClassName}`}>{roleLabel}</span>
            </div>
          )}
        </div>
      </header>

      {/* Fascia Hero Larga - 1100px centrata */}
      <div class="article-hero-wrapper">
        <div class="article-hero-image-wrapper">
          <img 
            src={articleImage} 
            alt={articleTitle}
            class="article-image"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-copertina-fallback
            onerror={COPERTINA_IMG_ONERROR}
          />
          {heroCaption && (
            <div class="article-image-caption">
              <img src="https://www.ombreeluci.it/wp-content/uploads/2023/10/icon-camera.png" alt="" class="caption-camera-icon" aria-hidden="true" />
              <span set:html={heroCaption} />
            </div>
          )}
        </div>
      </div>

      {/* Alert box per contenuti archivistici */}
      {articleDate.getFullYear() < 2000 && (
        <div class="article-header-wrapper">
          {locale === 'en' ? (
            <div class="archival-alert-en">
              <strong>This archival content from {articleDate.getFullYear()} reflects the language and sensitivities of its time.</strong>
            </div>
          ) : (
            <div class="archival-alert">
              <strong>Contenuto d'archivio:</strong> Questo articolo del {articleDate.getFullYear()} riflette il linguaggio e le sensibilità del suo tempo.
            </div>
          )}
        </div>
      )}

      {/* Article body: flex row — sidebar sticky a sinistra, contenuto a destra */}
      <div class="article-body-row">

      {/* Social Sticky Bar — position: sticky, si ferma da solo a fine article-body-row */}
      <div class="social-sticky" id="social-sticky">
        <div class="social-sticky-inner">
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url.href}`} target="_blank" rel="noopener noreferrer" class="social-link facebook" aria-label={shareLabelFacebook}>
