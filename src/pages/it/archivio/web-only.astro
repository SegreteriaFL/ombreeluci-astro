---
/**
 * Pagina articoli solo online (senza numero di rivista).
 * Lista filtrata e ordinata; la presentazione è demandata ad ArticoliRullo.
 * Load-more: rimosso — pagina renderizza l'intera lista (decisione 2026-04-07).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticoliRullo from '../../../components/ArticoliRullo.astro';
import { getAllArticoliBuild } from '../../../lib/articoli-build';

const allArticles = await getAllArticoliBuild();

const articoli = allArticles
  .filter((a) => a.lang !== 'en' && a.numero_rivista == null)
  .sort((a, b) => {
    const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
    const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
    return tB - tA;
  });
---

<BaseLayout
  title={"Articoli solo online"}
  description={"Articoli pubblicati solo online su Ombre e Luci."}
  alternates={[
    { lang: 'it', url: 'https://ombreeluci.it/it/archivio/web-only/' },
    { lang: 'en', url: 'https://ombreeluci.it/en/archive/web-only/' },
  ]}
>
  <main class="site-main">
    <div class="container">
      <ArticoliRullo
        title="Pubblicato online"
        description={"Articoli pubblicati solo sul sito, senza numero di rivista cartacea."}
        articoli={articoli}
        pageSize={24}
      />
    </div>
  </main>
</BaseLayout>
