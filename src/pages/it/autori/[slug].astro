---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AuthorPageContent from '../../../components/AuthorPageContent.astro';
import { getMegaclusterForArticle, getRoleWeight } from '../../../config/taxonomy.js';
import { getAutoreBySlug, getArticoliByAutoreSlug, getAutoreImageUrl } from '../../../lib/directus';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/it/autori/', 302);

const [autore, articoli] = await Promise.all([
  getAutoreBySlug(slug),
  getArticoliByAutoreSlug(slug, 'it'),
]);

if (!autore) return new Response(null, { status: 404 });

const sorted = articoli.sort((a, b) => {
  const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
  const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
  if (tA !== tB) return tB - tA;
  const weightA = getRoleWeight(getMegaclusterForArticle(a).ruolo_editoriale);
  const weightB = getRoleWeight(getMegaclusterForArticle(b).ruolo_editoriale);
  return weightB - weightA;
});

const authorFotoId = autore.foto?.id ?? null;
// Senza foto in Directus si lascia undefined: BaseHead ricade su og-default.jpg.
// Il vecchio fallback `/assets/authors/<slug>.jpg` era sempre un 404 (public/assets/ non esiste).
const authorImagePath = authorFotoId ? getAutoreImageUrl(authorFotoId) : undefined;
const alternateUrl = `/en/authors/${autore.slug}/`;
---

<BaseLayout
  title={`Articoli di ${autore.nome_completo}`}
  description={`Leggi tutti i contributi di ${autore.nome_completo} pubblicati su Ombre e Luci`}
  lang="it"
  ogImage={authorImagePath}
  alternateArticleUrl={alternateUrl}
  alternates={[
    { lang: 'it', url: new URL(`/it/autori/${autore.slug}/`, Astro.site).href },
    { lang: 'en', url: new URL(`/en/authors/${autore.slug}/`, Astro.site).href },
  ]}
>
  <AuthorPageContent
    lang="it"
    author={autore}
    articles={sorted}
    basePath="/it"
  />
</BaseLayout>
