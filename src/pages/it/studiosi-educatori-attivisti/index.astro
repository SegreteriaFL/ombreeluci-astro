---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudosiContent from '../../../components/StudosiContent.astro';
import { getAllAutori } from '../../../lib/directus';
import slugsOrdinati from '../../../data/studiosi.json';

const tuttiAutori = await getAllAutori();
const slugSet = new Set(slugsOrdinati);
const autoriMap = new Map(tuttiAutori.filter(a => slugSet.has(a.slug)).map(a => [a.slug, a]));
const autori = slugsOrdinati.map(s => autoriMap.get(s)).filter(Boolean);
---

<BaseLayout
  title="Studiosi, educatori e attivisti — Ombre e Luci"
  description="Nel corso degli anni, Ombre e Luci ha ospitato contributi di studiosi, educatori e attivisti impegnati nella promozione dei diritti delle persone con disabilità."
  lang="it"
  alternateArticleUrl="/en/scholars-educators-activists/"
  alternates={[
    { lang: 'it', url: 'https://ombreeluci.it/it/studiosi-educatori-attivisti/' },
    { lang: 'en', url: 'https://ombreeluci.it/en/scholars-educators-activists/' },
  ]}
>
  <StudosiContent lang="it" autori={autori} />
</BaseLayout>
