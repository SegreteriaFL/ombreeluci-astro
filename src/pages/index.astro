---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePageContent from '../components/HomePageContent.astro';
import {
  getMegaclusterForArticle,
  getLabels,
  getRoleWeight,
  getCategorySlugForArticle,
} from '../config/taxonomy.js';
import { DIARISTI } from '../data/diari.js';
import { getAllArticoliBuild } from '../lib/articoli-build';
import {
  getAllAutori,
  getAllNumeriRivista,
  getArticoloCopertinaSrc,
  getAutoreImageUrl,
  getNumeroImageUrl,
  type NumeroRivista,
} from '../lib/directus';

// Tipo atteso da HomePageContent / IssueCard (nomi storici)
type NumeroRecord = {
  id_numero: string;
  tipo_rivista: string;
  numero_progressivo: number;
  anno_pubblicazione: number;
  display_title?: string;
  titolo_numero?: string;
  periodo_label?: string | null;
  sommario_lancio?: string | null;
  seo_description?: string | null;
  copertina_url?: string | null;
};

// Mappa NumeroRivista (Directus) → NumeroRecord (componenti)
function mapNumero(n: NumeroRivista): NumeroRecord {
  return {
    id_numero:          n.id_numero,
    tipo_rivista:       n.tipo === 'ins' ? 'insieme' : 'ombre_e_luci',
    numero_progressivo: n.numero_progressivo ?? 0,
    anno_pubblicazione: n.anno_pubblicazione ?? 0,
    display_title:      n.display_title ?? undefined,
    titolo_numero:      n.titolo_tema ?? n.display_title ?? undefined,
    periodo_label:      n.periodo_label ?? null,
    sommario_lancio:    n.descrizione ?? null,
    seo_description:    null,
    copertina_url:      getNumeroImageUrl(n),
  };
}

const rawNumeri  = await getAllNumeriRivista();
const numeriOEL  = rawNumeri
  .filter(n => n.tipo !== 'ins')
  .sort((a, b) => {
    if ((a.anno_pubblicazione ?? 0) !== (b.anno_pubblicazione ?? 0))
      return (b.anno_pubblicazione ?? 0) - (a.anno_pubblicazione ?? 0);
    return (b.numero_progressivo ?? 0) - (a.numero_progressivo ?? 0);
  })
  .map(mapNumero);

const ultimoNumero = numeriOEL[0] ?? null;
const issueSlug = ultimoNumero
  ? ultimoNumero.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-')
  : '';
const numeriPerCarousel = numeriOEL.slice(0, 20);

const allAutori = await getAllAutori();
const autoriById: Record<string, { foto_url?: string }> = Object.fromEntries(
  allAutori.map((a) => [
    a.slug,
    { foto_url: a.foto?.id ? getAutoreImageUrl(a.foto.id) : undefined },
  ])
);

const allArticles = (await getAllArticoliBuild()).filter((a) => a.lang !== 'en');
type ArticoloItem = (typeof allArticles)[0];

const sortedArticles = [...allArticles].sort((a, b) => {
  const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
  const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
  if (tA !== tB) return tB - tA;
  const wA = getRoleWeight(getMegaclusterForArticle(a).ruolo_editoriale);
  const wB = getRoleWeight(getMegaclusterForArticle(b).ruolo_editoriale);
  return wB - wA;
});

function getArticleMeta(a: ArticoloItem) {
  const { categoria_menu } = getMegaclusterForArticle(a);
  const image = getArticoloCopertinaSrc(a);
  const date = a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date();
  const authorSlug = (a.autore as any)?.slug ?? '';
  return {
    slug: a.slug,
    title: a.titolo || 'Titolo mancante',
    author: a.autore?.nome_completo || 'Autore sconosciuto',
    authorAvatar: autoriById[authorSlug]?.foto_url ?? null,
    date,
    image,
    sommario: a.sottotitolo?.trim() || undefined,
    categoria_menu: categoria_menu ?? undefined,
    issue: a.numero_rivista?.id_numero ?? null,
    flagged: a.in_evidenza === true,
  };
}

const threeYearsAgo = new Date();
threeYearsAgo.setMonth(threeYearsAgo.getMonth() - 36);

// Set globale: ogni slug aggiunto non ricompare in nessuna sezione successiva.
// Ordine di priorità: hero → recenti → diari → testimonianze → esplora.
const usedSlugs = new Set<string>();

// 1. HERO SLIDER — pool di 50: flaggati (in_evidenza=true) sempre primi,
//    poi portanti/strutturali/laterali ultimi 36 mesi. Il JS client shuffla a ogni visita.
const rotationPool = (() => {
  const withCover = sortedArticles.filter((a) => !!getArticoloCopertinaSrc(a));
  const flagged = withCover.filter((a) => a.in_evidenza === true);
  const algorithmic = withCover.filter((a) => {
    if (a.in_evidenza === true) return false;
    const date = a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date(0);
    const { ruolo_editoriale } = getMegaclusterForArticle(a);
    return (
      ruolo_editoriale === 'portante' ||
      ruolo_editoriale === 'strutturale' ||
      ruolo_editoriale === 'laterale'
    ) && date >= threeYearsAgo;
  });
  const pool = [...flagged, ...algorithmic];
  if (pool.length < 4) pool.push(...withCover.filter((a) => !pool.includes(a)));
  return pool.slice(0, 50);
})().map((a) => { usedSlugs.add(a.slug); return getArticleMeta(a); });

// Alias per retrocompatibilità col componente (usato anche come featuredPool statico)
const featuredPool = rotationPool.slice(0, 4);

// 2. RECENTI (sezione sotto hero) — pool di 25, JS shuffla e mostra 7 a ogni visita
const latestArticles = sortedArticles
  .filter((a) => !usedSlugs.has(a.slug))
  .slice(0, 25)
  .map((a) => { usedSlugs.add(a.slug); return getArticleMeta(a); });

// 3. DIARI — ultimo articolo per diarista, esclude hero+recenti
const latestPerDiario = DIARISTI
  .map((diarista) => {
    const article = allArticles
      .filter((a) => (a.autore?.nome_completo || '').trim() === diarista.nome && !usedSlugs.has(a.slug))
      .sort((a, b) => {
        const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
        const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
        return tB - tA;
      })[0];
    if (!article) return null;
    usedSlugs.add(article.slug);
    return { diarista, meta: getArticleMeta(article), date: article.data_pubblicazione ? new Date(article.data_pubblicazione).getTime() : 0 };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => b.date - a.date)
  .slice(0, 8);

// 4. TESTIMONIANZE — pool top-10, rotazione giornaliera (cambia ogni nightly build)
const testimonianzePoll = sortedArticles
  .filter((a) => getLabels([], a).formal === 'Testimonianza' && !usedSlugs.has(a.slug))
  .slice(0, 10);
const _tDay = Math.floor(Date.now() / 86400000);
const _t0 = _tDay % Math.max(testimonianzePoll.length, 1);
const _t1 = (_tDay + 1) % Math.max(testimonianzePoll.length, 1);
const testimonianze = (testimonianzePoll.length >= 2
  ? [testimonianzePoll[_t0], testimonianzePoll[_t1]]
  : testimonianzePoll.slice(0, 2)
).filter(Boolean).map((a) => { usedSlugs.add(a.slug); return getArticleMeta(a); });

// 5. ESPLORA — primo articolo non usato per categoria
const EXPLORE_CATEGORIES = [
  'Fede e Luce', 'Famiglia', 'Spiritualità', 'Cultura',
  'Scuola e educazione', 'Salute', 'Lavoro', 'Personaggi che ispirano',
];

const exploreItems = EXPLORE_CATEGORIES.map((catLabel) => {
  const article = sortedArticles.find(
    (a) => getMegaclusterForArticle(a).categoria_menu === catLabel && !usedSlugs.has(a.slug)
  );
  if (!article) return null;
  const slug = getCategorySlugForArticle(article);
  if (!slug) return null;
  usedSlugs.add(article.slug);
  return { catLabel, slug, meta: getArticleMeta(article) };
}).filter((x): x is NonNullable<typeof x> => x !== null);
---

<BaseLayout
  title="Ombre e Luci – Un nuovo sguardo attraverso la disabilità"
  description="Ombre e Luci: storie, riflessioni e cultura sulla fragilità e sulla dignità della persona. Dal 1983."
  lang="it"
  bodyClass="home-page"
  alternateArticleUrl="/en/"
  heroHeader={true}
  alternates={[
    { lang: 'it', url: 'https://ombreeluci.it/' },
    { lang: 'en', url: 'https://ombreeluci.it/en/' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Ombre e Luci",
        "url": "https://ombreeluci.it",
        "logo": "https://ombreeluci.it/logo.svg",
        "sameAs": [
          "https://www.facebook.com/OmbreeLuciRivista/",
          "https://www.instagram.com/ombreeluci_magazine/",
          "https://x.com/Ombre_Luci",
          "https://www.youtube.com/channel/UCypEHP-N_RaUiz1BcBsplVQ"
        ],
        "foundingDate": "1983",
        "description": "Rivista trimestrale sulla disabilità e sulla fragilità umana. Dal 1983.",
        "publisher": {
          "@type": "Organization",
          "name": "Associazione Fede e Luce A.P.S.",
          "url": "https://www.fedeeluce.it"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Ombre e Luci",
        "url": "https://ombreeluci.it",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://ombreeluci.it/cerca?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ])} />
  </Fragment>

  <HomePageContent
    lang="it"
    featuredPool={featuredPool}
    rotationPool={rotationPool}
    latestArticles={latestArticles}
    diariCards={latestPerDiario.map(({ diarista, meta }) => ({
      diarista,
      meta,
      fotoUrl: autoriById[diarista.authorSlug]?.foto_url || '',
    }))}
    closeUpArticles={[]}
    testimonianze={testimonianze}
    exploreItems={exploreItems.map(({ catLabel, slug, meta }) => ({
      catLabel,
      catUrl: `/it/categoria/${slug}`,
      meta,
    }))}
    numeriPerCarousel={numeriPerCarousel}
    ultimoNumero={ultimoNumero}
    issueSlug={issueSlug}
  />
</BaseLayout>
