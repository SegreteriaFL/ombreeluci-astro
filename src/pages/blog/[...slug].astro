        display: block;
        width: 100%;
        margin: 2.5rem 0;
      }

      .incontent-related-card {
        display: flex !important;
        flex-direction: row;
        align-items: stretch;
        visibility: visible !important;
        opacity: 1 !important;
        position: relative;
        z-index: 1;
        max-width: 100%;
        margin: 2rem 0;
        clear: both;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.5rem 1.75rem;
        background: #ffffff;
        text-decoration: none;
        transition: box-shadow 0.2s ease, transform 0.15s ease;
      }

      .incontent-related-link {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        align-items: stretch;
        color: inherit;
        text-decoration: none;
        max-width: 100%;
        width: 100%;
      }

      .incontent-related-image-wrapper {
        flex: 0 0 38%;
        max-width: 38%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 10px;
        background: #f3f3f3;
      }

      .incontent-related-image-wrapper img {
        width: 100%;
        height: 100%;
        max-width: 100%;
        object-fit: cover;
        display: block;
      }

      .incontent-related-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
