      }

      .article-meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .article-meta-author-image {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
      }

      .article-meta-author-placeholder {
        width: 32px;
        height: 32px;
        border-radius: 50%;
