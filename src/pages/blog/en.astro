---
import BaseLayout from '../../layouts/BaseLayout.astro';
/**
 * Blog EN – Indice articoli in inglese (src/content/blog/en/).
 * Route: /blog/en
 */
import ArticleCard from '../../components/ArticleCard.astro';
import { getMegaclusterForArticle, getLabels } from '../../config/taxonomy.js';
import { t } from '../../utils/i18n';
import { getAllArticoli, getArticoloCopertinaSrc } from '../../lib/directus';

const allArticles = await getAllArticoli();
const englishArticles = allArticles
  .filter((a) => a.lang === 'en')
  .sort((a, b) => {
    const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
    const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
    return tB - tA;
  });
---

<BaseLayout
  title={`${t('en', 'english_articles')}`}
  description={"Articles in English from Ombre e Luci."}
  lang="en"
>
    <main class="site-main">
      <div class="en-container">
        <h1 class="en-title">{t('en', 'english_articles')}</h1>
        <p class="en-intro">Articles from Ombre e Luci available in English.</p>
        <div class="en-grid">
          {englishArticles.map((a) => {
            const image = getArticoloCopertinaSrc(a);
            const { categoria_menu } = getMegaclusterForArticle(a);
            const { formal } = getLabels([], a);
            return (
              <ArticleCard
                title={a.titolo}
                slug={a.slug}
                categoriaMenu={categoria_menu ?? undefined}
                issue={a.numero_rivista?.id_numero ?? null}
                forma={formal}
                author={a.autore?.nome_completo ?? 'Autore sconosciuto'}
                date={a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date()}
                image={image}
              />
            );
          })}
        </div>
      </div>
    </main>
  </body>
</html>
</BaseLayout>
