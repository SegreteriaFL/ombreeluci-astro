---
/**
 * Blog EN – Indice articoli in inglese (src/content/blog/en/).
 * Route: /blog/en
 */
import { ViewTransitions } from 'astro:transitions';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getMegaclusterForArticle, getLabels } from '../../config/taxonomy.js';
import { t } from '../../utils/i18n';
import '../../styles/global.css';
import { getAllArticoli, getArticoloCopertinaSrc } from '../../lib/directus';

const allArticles = await getAllArticoli();
const englishArticles = allArticles
  .filter((a) => a.lang === 'en')
  .sort((a, b) => {
    const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
    const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
    return tB - tA;
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t('en', 'english_articles')} – Ombre e Luci</title>
    <meta name="description" content="Articles in English from Ombre e Luci." />
    <ViewTransitions />
    <style>
      .en-page {
        min-height: 100vh;
        background: var(--bg-light, #f5f5f3);
      }
      .en-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      .en-title {
        font-family: 'Raleway', system-ui, -apple-system, sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0.5rem;
      }
      .en-intro {
        font-size: 1rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }
      .en-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }
      .en-grid > * {
        width: 100%;
      }
    </style>
  </head>
  <body class="en-page">
    <Header pathname={Astro.url.pathname} />
    <main class="site-main">
      <div class="en-container">
        <h1 class="en-title">{t('en', 'english_articles')}</h1>
        <p class="en-intro">Articles from Ombre e Luci available in English.</p>
        <div class="en-grid">
          {englishArticles.map((a) => {
            const image = getArticoloCopertinaSrc(a);
            const { categoria_menu } = getMegaclusterForArticle(a);
            const { formal } = getLabels([], a);
            return (
              <ArticleCard
                title={a.titolo}
                slug={a.slug}
                categoriaMenu={categoria_menu ?? undefined}
                issue={a.numero_rivista?.id_numero ?? null}
                forma={formal}
                author={a.autore?.nome_completo ?? 'Autore sconosciuto'}
                date={a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date()}
                image={image}
              />
            );
          })}
        </div>
      </div>
    </main>
    <Footer pathname={Astro.url.pathname} />
  </body>
</html>
