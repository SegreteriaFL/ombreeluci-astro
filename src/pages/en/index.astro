---
/**
 * EN article index: /en/
 *
 * Corrisponde alla vecchia /blog/en (ora redirect 301 → /en/).
 * ArticleCard usa basePath="/en" per generare link /en/[slug] (senza suffisso -en).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getMegaclusterForArticle, getLabels } from '../../config/taxonomy.js';
import { t } from '../../utils/i18n';
import { getAllArticoliBuild } from '../../lib/articoli-build';
import { getArticoloCopertinaSrc } from '../../lib/directus';

const allArticles = await getAllArticoliBuild();
const englishArticles = allArticles
  .filter((a) => a.lang === 'en')
  .sort((a, b) => {
    const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
    const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
    return tB - tA;
  });

// slug EN → URL EN: rimuove il suffisso -en per costruire /en/[slug-senza-en]
function toEnUrl(slug: string): string {
  return slug.endsWith('-en') ? slug.slice(0, -3) : slug;
}
---

<BaseLayout
  title={`${t('en', 'english_articles')}`}
  description="Articles in English from Ombre e Luci."
  lang="en"
  canonical="https://ombreeluci.it/en/"
  pathname="/en/"
>
  <main class="site-main">
    <div class="container" style="padding-top: 2.5rem; padding-bottom: 3rem;">
      <h1 style="margin-bottom: 0.5rem;">{t('en', 'english_articles')}</h1>
      <p style="color: var(--text-secondary); margin-bottom: 2rem;">Articles from Ombre e Luci available in English.</p>
      <div class="en-grid">
        {englishArticles.map((a) => {
          const image = getArticoloCopertinaSrc(a);
          const { categoria_menu } = getMegaclusterForArticle(a);
          const { formal } = getLabels([], a);
          return (
            <ArticleCard
              title={a.titolo}
              slug={toEnUrl(a.slug)}
              categoriaMenu={categoria_menu ?? undefined}
              issue={a.numero_rivista?.id_numero ?? null}
              forma={formal}
              author={a.autore?.nome_completo ?? t('en', 'author_unknown')}
              date={a.data_pubblicazione ? new Date(a.data_pubblicazione) : new Date()}
              image={image}
              lang="en"
              basePath="/en"
            />
          );
        })}
      </div>
    </div>
  </main>

<style>
  .en-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  @media (max-width: 1024px) { .en-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .en-grid { grid-template-columns: 1fr; } }
</style>
</BaseLayout>
