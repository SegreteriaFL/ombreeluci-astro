---
/**
 * EN article index: /en/
 * SSR — mostra tutti gli articoli EN via ArticoliRullo (load-more incluso).
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticoliRullo from '../../components/ArticoliRullo.astro';
import { t } from '../../utils/i18n';
import { getArticoliEN, directusCredsFromAstroLocals } from '../../lib/directus';

const creds = directusCredsFromAstroLocals(Astro.locals);
const englishArticles = await getArticoliEN(creds);

Astro.response.headers.set('Cache-Control', 's-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout
  title={t('en', 'english_articles')}
  description="Articles from Ombre e Luci available in English."
  lang="en"
  canonical="https://ombreeluci.it/en/"
  pathname="/en/"
>
  <main class="site-main">
    <div class="container">
      <ArticoliRullo
        title={t('en', 'english_articles')}
        description="Articles from Ombre e Luci available in English."
        articoli={englishArticles}
        pageSize={24}
        basePath="/en"
        locale="en"
      />
    </div>
  </main>
</BaseLayout>
