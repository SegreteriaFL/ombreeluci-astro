---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IssueContent from '../../../components/IssueContent.astro';
import { getAllNumeriRivista, getArticoliByNumero, getNumeroImageUrl } from '../../../lib/directus';

// SSR: ogni visita legge Directus live — articoli nuovi visibili subito senza rebuild
export const prerender = false;

const { issue } = Astro.params;
if (!issue) return Astro.redirect('/en/archive/');

const rawNumeri = await getAllNumeriRivista();

function numProgressivo(idNumero: string): number {
  const m = idNumero.match(/(\d+)$/);
  return m ? parseInt(m[1], 10) : 0;
}

const numeriOrdinati = [...rawNumeri].sort((a, b) => {
  const annoA = a.anno_pubblicazione ?? 0;
  const annoB = b.anno_pubblicazione ?? 0;
  if (annoA !== annoB) return annoA - annoB;
  return numProgressivo(a.id_numero) - numProgressivo(b.id_numero);
});

const index = numeriOrdinati.findIndex(
  n => n.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-') === issue
);
if (index === -1) return Astro.redirect('/en/archive/');

const numero = numeriOrdinati[index];
const prevNumero = index > 0 ? numeriOrdinati[index - 1] : null;
const nextNumero = index < numeriOrdinati.length - 1 ? numeriOrdinati[index + 1] : null;
const prevSlug = prevNumero ? prevNumero.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-') : null;
const nextSlug = nextNumero ? nextNumero.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-') : null;

// Solo articoli EN del numero, query live
const articoliAll = await getArticoliByNumero(numero.id_numero);
const articoliNumero = articoliAll.filter(a => a.lang === 'en');

const copertinaNumeroUrl = getNumeroImageUrl(numero);
const testata = numero.tipo === 'ins' ? 'Insieme' : 'Ombre e Luci';
---

<BaseLayout
  title={`${numero.display_title} – Archive`}
  description={`${testata} – ${numero.display_title}: browse articles and download the PDF.`}
  noindex={true}
  ogImage={copertinaNumeroUrl}
  lang="en"
  alternateArticleUrl={`/it/archivio/${numero.id_numero.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`}
>
  <IssueContent
    lang="en"
    numero={numero}
    prevSlug={prevSlug}
    nextSlug={nextSlug}
    articoliNumero={articoliNumero}
    archiveBasePath="/en/archive"
  />
</BaseLayout>
