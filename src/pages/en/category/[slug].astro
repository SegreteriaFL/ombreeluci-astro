---
/**
 * EN category page: /en/category/[slug]
 * Shows all EN articles in a given category (categoria_menu slug).
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoriaPageContent from '../../../components/CategoriaPageContent.astro';
import {
  getArticoliByCategoria,
  directusCredsFromAstroLocals,
} from '../../../lib/directus';
import { localizeCategory } from '../../../utils/i18n';
import { getMegaclusterForArticle, getRoleWeight, getCategoriaSlugIT } from '../../../config/taxonomy.js';

const { redirect } = Astro;
const creds = directusCredsFromAstroLocals(Astro.locals);
const enSlug = (Astro.params.slug ?? '').replace(/\/$/, '');
const itSlug = getCategoriaSlugIT(enSlug, 'en');

const articoli = await getArticoliByCategoria(itSlug, 'en', creds);

if (!articoli.length) {
  return redirect('/en/', 302);
}

const categoryLabel = localizeCategory(itSlug, 'en') ?? enSlug;

const sorted = [...articoli].sort((a, b) => {
  const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
  const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
  if (tA !== tB) return tB - tA;
  const wA = getRoleWeight(getMegaclusterForArticle(a).ruolo_editoriale);
  const wB = getRoleWeight(getMegaclusterForArticle(b).ruolo_editoriale);
  return wB - wA;
});

Astro.response.headers.set('Cache-Control', 's-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout
  title={categoryLabel}
  description={`English articles in category "${categoryLabel}" on Ombre e Luci.`}
  noindex={true}
  lang="en"
  alternateArticleUrl={`/categoria/${itSlug}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ombreeluci.it/en/" },
        { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": Astro.url.href }
      ]
    })} />
  </Fragment>
  <main class="site-main">
    <CategoriaPageContent
      articoli={sorted}
      categoryLabel={categoryLabel}
      lang="en"
      basePath="/en"
    />
  </main>
</BaseLayout>
