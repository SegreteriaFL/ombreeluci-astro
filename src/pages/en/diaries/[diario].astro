---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiarioContent from '../../../components/DiarioContent.astro';
import { DIARISTI, getDiaristaByDiarioSlug } from '../../../data/diari.ts';
import { getAllAutori, getAutoreImageUrl } from '../../../lib/directus';
import { getAllArticoliBuild } from '../../../lib/articoli-build';

export async function getStaticPaths() {
  const allArticoli = await getAllArticoliBuild();
  const allAutori = await getAllAutori();

  const paths: { params: { diario: string }; props: Record<string, unknown> }[] = [];

  for (const d of DIARISTI) {
    const autore = allAutori.find((a) => a.slug === d.authorSlug);
    const fotoUrl = autore?.foto?.id ? getAutoreImageUrl(autore.foto.id) : '';

    const articoli = allArticoli
      .filter((a) => a.lang === 'en' && (a.autore?.nome_completo || '').trim() === d.nome)
      .sort((a, b) => {
        const tA = a.data_pubblicazione ? new Date(a.data_pubblicazione).getTime() : 0;
        const tB = b.data_pubblicazione ? new Date(b.data_pubblicazione).getTime() : 0;
        return tB - tA;
      });

    paths.push({
      params: { diario: d.diarioSlug },
      props: {
        nomeAutore: d.nome,
        titoloDiario: d.titoloDiario,
        fotoUrl,
        descrizioneDiario: d.descrizioneDiario,
        articoli,
      },
    });
  }

  return paths;
}

const { diario } = Astro.params;
const diarista = diario ? getDiaristaByDiarioSlug(diario) : undefined;

if (!diarista) {
  return Astro.redirect('/404');
}

const { nomeAutore, titoloDiario, fotoUrl, descrizioneDiario, articoli } = Astro.props;
---

<BaseLayout
  title={String(titoloDiario)}
  description={`Read the diary entries and articles by ${nomeAutore}, ${titoloDiario}, in Ombre e Luci.`}
  noindex={true}
  lang="en"
  alternateArticleUrl={`/diari/${diarista.diarioSlug}`}
>
  <DiarioContent
    lang="en"
    nomeAutore={String(nomeAutore)}
    titoloDiario={String(titoloDiario)}
    fotoUrl={String(fotoUrl)}
    descrizioneDiario={String(descrizioneDiario)}
    articoli={articoli as any}
  />
</BaseLayout>
