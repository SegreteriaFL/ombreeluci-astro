---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllAutori, getAutoreImageUrl } from '../../../lib/directus';
import { getAllArticoliBuild } from '../../../lib/articoli-build';

function stripHtml(html: string): string {
  return html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}

const [allAutori, allArticoli] = await Promise.all([getAllAutori(), getAllArticoliBuild()]);

const enCountBySlug = new Map<string, number>();
for (const a of allArticoli) {
  if (a.lang === 'en' && a.autore?.slug) {
    enCountBySlug.set(a.autore.slug, (enCountBySlug.get(a.autore.slug) ?? 0) + 1);
  }
}

const autori = allAutori
  .filter((autore) => (enCountBySlug.get(autore.slug) ?? 0) > 0)
  .map((autore) => {
    const foto = autore.foto?.id ? getAutoreImageUrl(autore.foto.id) : '';
    const bioRaw = autore.bio_en?.trim() || autore.bio_html || '';
    const bioText = bioRaw ? stripHtml(bioRaw) : '';
    const bio_breve = bioText ? (bioText.slice(0, 120) + (bioText.length > 120 ? '…' : '')) : '';
    return {
      nome: autore.nome_completo,
      slug: autore.slug,
      foto,
      bio_breve,
      count_articoli: enCountBySlug.get(autore.slug) ?? 0,
    };
  });
---

<BaseLayout
  title={"Authors"}
  description={"Contributors to the Ombre e Luci magazine"}
  lang="en"
  noindex={true}
  alternateArticleUrl="/autori/"
>
    <main class="site-main autori-page">
      <div class="autori-container">
        <h1 class="autori-title">Authors</h1>
        <p class="autori-intro">Explore the contributors to Ombre e Luci magazine.</p>

        <div class="autori-toolbar">
          <div class="autori-search-wrap">
            <label for="autori-search" class="visually-hidden">Search author</label>
            <input
              type="search"
              id="autori-search"
              class="autori-search"
              placeholder="Search by name..."
              aria-label="Search author"
            />
          </div>
          <div class="autori-sort-wrap">
            <label for="autori-sort" class="autori-sort-label">Sort by</label>
            <select id="autori-sort" class="autori-sort" aria-label="Sort authors">
              <option value="count-desc">Most articles</option>
              <option value="count-asc">Fewest articles</option>
              <option value="name-asc">Name A–Z</option>
              <option value="name-desc">Name Z–A</option>
            </select>
          </div>
        </div>

        <div id="autori-grid" class="autori-grid">
          {autori.map((autore) => (
            <a href={`/en/authors/${autore.slug}`} class="autori-card" data-nome={autore.nome.toLowerCase()} data-count={autore.count_articoli}>
              <div class="autori-card-image">
                {autore.foto && !autore.foto.includes('default.png') ? (
                  <img src={autore.foto} alt="" width="80" height="80" loading="lazy" onError="this.style.display='none'; this.nextElementSibling?.classList.add('visible')" />
                ) : null}
                <span class={(!autore.foto || autore.foto.includes('default.png')) ? 'autori-card-initial visible' : 'autori-card-initial'} aria-hidden="true">{autore.nome.charAt(0).toUpperCase()}</span>
              </div>
              <div class="autori-card-body">
                <h2 class="autori-card-name">{autore.nome}</h2>
                <p class="autori-card-count">{autore.count_articoli} {autore.count_articoli === 1 ? 'article' : 'articles'}</p>
                <p class="autori-card-bio">{autore.bio_breve}</p>
              </div>
            </a>
          ))}
        </div>

        <p id="autori-no-results" class="autori-no-results" style="display: none;">No authors found.</p>
      </div>
    </main>

    <style>
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .autori-page {
        min-height: 60vh;
        padding: 2rem 0 4rem;
        background: #fafafa;
      }
      .autori-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      .autori-title {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-color);
        margin: 0 0 0.5rem;
      }
      .autori-intro {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 0 0 1.5rem;
      }
      .autori-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
        align-items: center;
      }
      .autori-search-wrap {
        flex: 1;
        min-width: 200px;
      }
      .autori-search {
        width: 100%;
        max-width: 320px;
        padding: 0.5rem 1rem;
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 0.95rem;
        border: 1px solid #e5e5e5;
        border-radius: 0;
        background: #fff;
        color: var(--text-color);
      }
      .autori-search:focus {
        outline: none;
        border-color: var(--accent-color);
      }
      .autori-sort-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .autori-sort-label {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }
      .autori-sort {
        padding: 0.5rem 0.75rem;
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 0.875rem;
        border: 1px solid #e5e5e5;
        background: #fff;
        color: var(--text-color);
      }
      .autori-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
      }
      .autori-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1.25rem;
        background: #fff;
        border: 1px solid #e5e5e5;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .autori-card:hover {
        border-color: var(--accent-color);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }
      .autori-card-image {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        background: #eee;
        margin-bottom: 0.75rem;
      }
      .autori-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .autori-card-initial {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: #777;
        background: #eee;
      }
      .autori-card-initial.visible {
        display: flex;
      }
      .autori-card-name {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-color);
        margin: 0 0 0.25rem;
      }
      .autori-card-count {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 0.8rem;
        color: #777;
        margin: 0 0 0.5rem;
      }
      .autori-card-bio {
        font-family: 'Raleway', system-ui, sans-serif;
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.35;
      }
      .autori-no-results {
        font-family: 'Raleway', system-ui, sans-serif;
        color: #777;
        margin-top: 1rem;
      }
      @media (max-width: 1024px) {
        .autori-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 600px) {
        .autori-grid {
          grid-template-columns: 1fr;
        }
        .autori-container {
          padding: 0 1rem;
        }
      }
    </style>

    <script>
      document.addEventListener('astro:page-load', function () {
        const grid = document.getElementById('autori-grid');
        const search = document.getElementById('autori-search');
        const sortSelect = document.getElementById('autori-sort');
        const noResults = document.getElementById('autori-no-results');
        const cards = grid ? Array.from(grid.querySelectorAll('.autori-card')) : [];

        function normalize(s) {
          return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        }

        function applyFilterAndSort() {
          const query = normalize((search && search.value) || '');
          let visible = cards;
          if (query) {
            visible = cards.filter((el) => normalize(el.dataset.nome || '').includes(query));
          }
          cards.forEach((el) => {
            el.style.display = visible.includes(el) ? '' : 'none';
          });
          if (noResults) noResults.style.display = visible.length === 0 ? 'block' : 'none';

          const order = (sortSelect && sortSelect.value) || 'count-desc';
          const items = visible.slice();
          if (order === 'count-desc') items.sort((a, b) => (b.dataset.count || 0) - (a.dataset.count || 0));
          else if (order === 'count-asc') items.sort((a, b) => (a.dataset.count || 0) - (b.dataset.count || 0));
          else if (order === 'name-asc') items.sort((a, b) => (a.dataset.nome || '').localeCompare(b.dataset.nome || ''));
          else if (order === 'name-desc') items.sort((a, b) => (b.dataset.nome || '').localeCompare(a.dataset.nome || ''));
          items.forEach((node) => grid.appendChild(node));
        }

        if (search) search.addEventListener('input', applyFilterAndSort);
        if (sortSelect) sortSelect.addEventListener('change', applyFilterAndSort);
        applyFilterAndSort();
      });
    </script>
</BaseLayout>
