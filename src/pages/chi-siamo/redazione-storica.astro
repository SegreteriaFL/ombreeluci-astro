---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutSidebar from '../../components/AboutSidebar.astro';
---

<BaseLayout
  title={"Redazione storica"}
  noindex={true}
>
    <main class="site-main">
      <div class="about-layout container">
        <AboutSidebar active="redazione-storica" />
        <div class="about-page-content">
          <h1>La Redazione storica</h1>
          <p>La storia della redazione di Ombre e Luci e i volti che hanno contribuito alla rivista nel corso degli anni.</p>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .about-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .about-page-content {
    flex: 1;
    min-width: 0;
  }

  .about-page-content h1 {
    margin-bottom: 1rem;
  }

  .about-page-content p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .about-layout {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
</BaseLayout>
