---
import BaseLayout from '../layouts/BaseLayout.astro';
import SostienicContent from '../components/SostienicContent.astro';
---

<BaseLayout
  title="Sostieni Ombre e Luci"
  description="Sostieni Ombre e Luci con una donazione. Senza sponsor: la rivista vive grazie a chi la legge."
  lang="it"
  bodyClass="support-page"
  alternateArticleUrl="/en/support-us/"
>
  <SostienicContent lang="it" />
</BaseLayout>

<style>
  /* Footer in flow quando finisce la sezione (niente fixed) */
  :global(.support-page) :global(.footer-reveal-wrap) :global(.reveal-spacer) {
    height: 0 !important;
  }
  :global(.support-page) :global(.site-footer) {
    position: static !important;
    left: auto !important;
    bottom: auto !important;
  }

  .support-page {
    padding-bottom: 2rem;
  }
</style>
