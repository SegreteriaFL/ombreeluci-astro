    "astro": "^4.15.0",
    "astro-pagefind": "^1.8.5",
    "cheerio": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.5.0",
    "zod": "^3.23.0"
