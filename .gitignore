_migration_archive/
*.xml

# environment variables
.env
.env.local
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code local session settings (personal, not team)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- Essenziali per il sito (NON ignorare, tenere in repo) ---
# src/data/*.json (articoli_megacluster.json, autori_stats.json) sono generati da script ma necessari per build
# _migration_archive/categorie v2/articoli_*_FINAL_V5.csv è la Source of Truth

# Private keys
*.pem

# Service account credentials (GSC API, ecc.)
.secrets/
gsc/

# Log temporanei script (verifiche redirect, ecc.)
scripts/logs/

# SQL dump database (troppo grande per git)
dump_db_old/

# Python cache
__pycache__/
*.pyc

# Placeholder originali JPG (sorgenti non ottimizzati — in repo solo i .webp)
public/placeholder/*.jpg
public/placeholder/*.jpeg
public/placeholder/*.png
# Cartella placeholder nella radice (posizione errata — usare public/placeholder/)
/placeholder/

# File temporanei script
scripts_and_data/scripts/_preview_markdown_before_after_tmp.py

# Credenziali VPS
vps_credentials.txt

# Variabili d'ambiente locali per wrangler pages dev (mai committare)
.dev.vars
hero-nectar/

# Wrangler build artifacts (locali, non committare)
.wrangler/

# File di lavoro privati
prompt_sicurezza.md

# Export articoli per traduzione manuale (TRANS-FLOW-01 — rigenerabili via script)
exports/

# Articoli AI OEL (dati grezzi, non nel repo)
articoli_aioel/
