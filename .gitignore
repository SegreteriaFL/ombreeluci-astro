dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# export PHP / dati grezzi (pesanti, rigenerabili)
estrai_tutto.*

